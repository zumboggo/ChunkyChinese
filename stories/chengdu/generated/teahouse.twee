:: StoryScript [script]
setup.episode={"id":"teahouse","version":4,"title":"One more cup","subtitle":"Introduce two people. Let the afternoon change.","place":"Teahouse","newWords":["同事","下雨","等一下"],"ending":"Ms Zhou refills the pot. Rain has changed the plan, but it has given us one more conversation. When I leave, there will already be a reason to come back.","scenes":[{"id":"conversation-1","title":"The right table","speaker":"zhou","paragraphs":["I arrive at the neighbourhood teahouse. Chen is looking for a table; Ms Lin has found the best chair. Ms Zhou explains what she can serve today. I listen before ordering."],"line":{"zh":"你好！今天只有热茶，想喝一杯吗？","english":"Hello! Today we only have hot tea. Would you like a cup?","pinyin":"nǐ hǎo ！ jīn tiān zhǐ yǒu rè chá ， xiǎng hē yì bēi ma ？","audio":"game/audio/ad0d81911a4ad4c514a6.m4a"},"kind":"choice","clue":"Listen for the drink available today, then order it.","choices":[{"id":"reply","label":"Listen for the drink available today, then order it.","simple":{"chunks":["我","想要","一杯","热茶"],"english":"I would like a cup of hot tea.","pinyin":["wǒ","xiǎng yào","yì bēi","rè chá"],"distractorPinyin":[],"audio":"game/audio/281e5ee3c7bab8770e06.m4a"},"rich":{"chunks":["我","想要","一杯","热茶"],"english":"I would like a cup of hot tea.","pinyin":["wǒ","xiǎng yào","yì bēi","rè chá"],"distractorPinyin":[],"audio":"game/audio/281e5ee3c7bab8770e06.m4a"},"hint":"Listen for the drink available today, then order it.","response":"","responseLine":{"zh":"好，一杯热茶。请坐！","english":"Of course, a cup of hot tea. Please sit!","pinyin":"hǎo ， yì bēi rè chá 。 qǐng zuò ！","audio":"game/audio/72069022f25aeb8e393b.m4a"}}],"options":[{"id":"correct","correct":true,"simple":"我想要一杯热茶","rich":"我想要一杯热茶","simplePinyin":"wǒ xiǎng yào yì bēi rè chá","simpleAudio":"game/audio/281e5ee3c7bab8770e06.m4a","richPinyin":"wǒ xiǎng yào yì bēi rè chá","richAudio":"game/audio/281e5ee3c7bab8770e06.m4a"},{"id":"wrong-1","simple":"我想要一杯冷茶。","rich":"我想要一杯冷茶。","feedback":"Listen again for the drink she can serve.","simplePinyin":"wǒ xiǎng yào yì bēi lěng chá 。","simpleAudio":"game/audio/331c31aca370b38e5b14.m4a","richPinyin":"wǒ xiǎng yào yì bēi lěng chá 。","richAudio":"game/audio/331c31aca370b38e5b14.m4a"},{"id":"wrong-2","simple":"我想要一杯冷水。","rich":"我想要一杯冷水。","feedback":"Listen again for the drink she can serve.","simplePinyin":"wǒ xiǎng yào yì bēi lěng shuǐ 。","simpleAudio":"game/audio/f951e6f97a5ece211cbb.m4a","richPinyin":"wǒ xiǎng yào yì bēi lěng shuǐ 。","richAudio":"game/audio/f951e6f97a5ece211cbb.m4a"}],"aside":{"question":"Recall this moment","answer":"I arrive at the neighbourhood teahouse. Chen is looking for a table; Ms Lin has found the best chair. Ms Zhou explains what she can serve today. I listen before ordering."},"promptMode":"listen"},{"id":"conversation-2","title":"Put two names together","speaker":"lin","paragraphs":["Ms Lin waves Chen toward the table, then looks to me. I know who everyone is; they do not. This is a small piece of useful Chinese I can supply."],"line":{"zh":"这是谁？他也是老师吗？","english":"Who is this? Is he a teacher too?","pinyin":"zhè shì shuí ？ tā yě shì lǎo shī ma ？","audio":"game/audio/9e9b8cc4dcedcb052f47.m4a"},"kind":"choice","clue":"Introduce Chen as your colleague.","choices":[{"id":"reply","label":"Introduce Chen as your colleague.","simple":{"chunks":["这是","我的同事","他","姓陈"],"english":"This is my colleague; his surname is Chen.","pinyin":["zhè shì","wǒ de tóng shì","tā","xìng chén"],"distractorPinyin":[],"audio":"game/audio/13d853d7cd050b04a1ab.m4a"},"rich":{"chunks":["这是","我的同事","他","姓陈"],"english":"This is my colleague; his surname is Chen.","pinyin":["zhè shì","wǒ de tóng shì","tā","xìng chén"],"distractorPinyin":[],"audio":"game/audio/13d853d7cd050b04a1ab.m4a"},"hint":"Listen again and look for the part that answers the question.","response":"","responseLine":{"zh":"陈老师，你好！","english":"Hello, Teacher Chen!","pinyin":"chén lǎo shī ， nǐ hǎo ！","audio":"game/audio/b39f9dceb82a54383151.m4a"}}],"options":[{"id":"correct","correct":true,"simple":"这是我的同事他姓陈","rich":"这是我的同事他姓陈","simplePinyin":"zhè shì wǒ de tóng shì tā xìng chén","simpleAudio":"game/audio/13d853d7cd050b04a1ab.m4a","richPinyin":"zhè shì wǒ de tóng shì tā xìng chén","richAudio":"game/audio/13d853d7cd050b04a1ab.m4a"},{"id":"wrong-1","simple":"这是我的学生。","rich":"这是我的学生。","feedback":"学生 means student. Chen works with you.","simplePinyin":"zhè shì wǒ de xué shēng 。","simpleAudio":"game/audio/a6d6367e5fb63b0c7dfe.m4a","richPinyin":"zhè shì wǒ de xué shēng 。","richAudio":"game/audio/a6d6367e5fb63b0c7dfe.m4a"},{"id":"wrong-2","simple":"我是你的同事。","rich":"我是你的同事。","feedback":"我是 introduces yourself, but she is asking about Chen.","simplePinyin":"wǒ shì nǐ de tóng shì 。","simpleAudio":"game/audio/f86e34df821bda13cb84.m4a","richPinyin":"wǒ shì nǐ de tóng shì 。","richAudio":"game/audio/f86e34df821bda13cb84.m4a"}],"aside":{"question":"Recall this moment","answer":"Ms Lin waves Chen toward the table, then looks to me. I know who everyone is; they do not. This is a small piece of useful Chinese I can supply."}},{"id":"conversation-3","title":"A word under the rain","speaker":"zhou","paragraphs":["Chen shows us his book. Just as we begin talking about a walk, rain drums on the roof. Ms Zhou moves a chair away from the doorway and speaks over the noise. I need to hear that again."],"line":{"zh":"下雨了。等一下再走吧。","english":"It is raining. Wait a little before leaving.","pinyin":"xià yǔ le 。 děng yí xià zài zǒu ba 。","audio":"game/audio/2602e6c7d2a94562b99d.m4a"},"kind":"choice","clue":"Politely ask Ms Zhou to repeat what she said.","choices":[{"id":"reply","label":"Politely ask Ms Zhou to repeat what she said.","simple":{"chunks":["请","再说","一遍"],"english":"Please say it again.","pinyin":["qǐng","zài shuō","yí biàn"],"distractorPinyin":[],"audio":"game/audio/a65bbc3864b52e5a91e4.m4a"},"rich":{"chunks":["请","再说","一遍"],"english":"Please say it again.","pinyin":["qǐng","zài shuō","yí biàn"],"distractorPinyin":[],"audio":"game/audio/a65bbc3864b52e5a91e4.m4a"},"hint":"Listen again and look for the part that answers the question.","response":"","responseLine":{"zh":"下雨了。你们可以在这里等一下。","english":"It is raining. You can wait here a little.","pinyin":"xià yǔ le 。 nǐ men kě yǐ zài zhè lǐ děng yí xià 。","audio":"game/audio/a1f7fa7b03484fd9213b.m4a"}}],"options":[{"id":"correct","correct":true,"simple":"请再说一遍","rich":"请再说一遍","simplePinyin":"qǐng zài shuō yí biàn","simpleAudio":"game/audio/a65bbc3864b52e5a91e4.m4a","richPinyin":"qǐng zài shuō yí biàn","richAudio":"game/audio/a65bbc3864b52e5a91e4.m4a"},{"id":"wrong-1","simple":"我们现在就走吧。","rich":"我们现在就走吧。","feedback":"That proposes leaving now. You need to hear her suggestion again first.","simplePinyin":"wǒ men xiàn zài jiù zǒu ba 。","simpleAudio":"game/audio/94d95e45fa089737e00d.m4a","richPinyin":"wǒ men xiàn zài jiù zǒu ba 。","richAudio":"game/audio/94d95e45fa089737e00d.m4a"},{"id":"wrong-2","simple":"我不喜欢喝茶。","rich":"我不喜欢喝茶。","feedback":"That changes the subject to tea preferences.","simplePinyin":"wǒ bù xǐ huan hē chá 。","simpleAudio":"game/audio/d2cf98c7fa8c6e642a20.m4a","richPinyin":"wǒ bù xǐ huan hē chá 。","richAudio":"game/audio/d2cf98c7fa8c6e642a20.m4a"}],"aside":{"question":"Recall this moment","answer":"Chen shows us his book. Just as we begin talking about a walk, rain drums on the roof. Ms Zhou moves a chair away from the doorway and speaks over the noise. I need to hear that again."}},{"id":"conversation-4","title":"One more cup","speaker":"chen","paragraphs":["The courtyard stones darken. Chen looks at the rain, then the nearly empty teapot. We can turn our walk into a longer conversation. Ms Zhou is already lifting the kettle."],"line":{"zh":"我们现在走吗？","english":"Shall we leave now?","pinyin":"wǒ men xiàn zài zǒu ma ？","audio":"game/audio/4bd7a3dcf9b700b7dc82.m4a"},"kind":"build","clue":"Suggest staying here a little and having tea together.","choices":[{"id":"reply","label":"Suggest staying here a little and having tea together.","simple":{"chunks":["我们","在这里","等一下","一起","喝茶","吧"],"english":"Let’s wait here a little and have tea together.","distractors":["现在走","昨天"],"pinyin":["wǒ men","zài zhè lǐ","děng yí xià","yì qǐ","hē chá","ba"],"distractorPinyin":["xiàn zài zǒu","zuó tiān"],"audio":"game/audio/1efda7758d760bf6ff88.m4a"},"rich":{"chunks":["我们","在这里","等一下","一起","喝茶","吧"],"english":"Let’s wait here a little and have tea together.","distractors":["现在走","昨天"],"pinyin":["wǒ men","zài zhè lǐ","děng yí xià","yì qǐ","hē chá","ba"],"distractorPinyin":["xiàn zài zǒu","zuó tiān"],"audio":"game/audio/1efda7758d760bf6ff88.m4a"},"hint":"Put 在这里 before 等一下. Keep 一起 with 喝茶; 吧 goes last.","response":"","responseLine":{"zh":"好，我们再喝一杯！","english":"Good idea. Let’s have another cup!","pinyin":"hǎo ， wǒ men zài hē yì bēi ！","audio":"game/audio/0f948cb978b2e7812101.m4a"}}],"aside":{"question":"Recall this moment","answer":"The courtyard stones darken. Chen looks at the rain, then the nearly empty teapot. We can turn our walk into a longer conversation. Ms Zhou is already lifting the kettle."}}],"order":3,"ifid":"763C276A-AE23-4C9C-A607-71F1B861C566","location":"teahouse","mapLabel":"Visit Ms Zhou","participants":["lin","chen","zhou"],"milestone":"familiar-table","vocabularyRefs":["同事","下雨","等一下"],"memoryCheck":{"id":"lin-tea-at-table","fact":"lin-tea","speaker":"lin","question":{"zh":"你还记得我喜欢喝什么吗？","english":"Do you remember what I like to drink?","pinyin":"nǐ hái jì de wǒ xǐ huan hē shén me ma ？","audio":"game/audio/9807810e843cc8028443.m4a"},"options":[{"id":"tea","line":{"zh":"你喜欢喝茶。","english":"You enjoy tea.","pinyin":"nǐ xǐ huan hē chá 。","audio":"game/audio/f85fe237dad8ef917f9c.m4a"},"correct":true},{"id":"coffee","line":{"zh":"你喜欢喝咖啡。","english":"You enjoy coffee.","pinyin":"nǐ xǐ huan hē kā fēi 。","audio":"game/audio/4f7061bc3141bca12d95.m4a"}}],"repair":{"zh":"不好意思，我记住了。你喜欢喝茶。","english":"Sorry, I remember now. You like tea.","pinyin":"bù hǎo yì si ， wǒ jì zhù le 。 nǐ xǐ huan hē chá 。","audio":"game/audio/7941b1e60c0bf7bf99f0.m4a"},"introduction":{"zh":"我喜欢喝茶。下次一起喝吧！","english":"I enjoy tea. Let’s have some together next time!","pinyin":"wǒ xǐ huan hē chá 。 xià cì yì qǐ hē ba ！","audio":"game/audio/0082b9d7619ec67d8d23.m4a"}},"world":{"characters":{"lin":{"name":"Ms Lin","role":"my neighbour","portrait":{"asset":"game/art/50f24f287923-characters.webp","column":0,"columns":3},"greeting":{"zh":"大卫，又见面了！","english":"David, nice to see you again!","pinyin":"dà wèi ， yòu jiàn miàn le ！","audio":"game/audio/339b8a93e23c5b5e542e.m4a"}},"chen":{"name":"Chen","role":"my colleague","portrait":{"asset":"game/art/50f24f287923-characters.webp","column":1,"columns":3},"greeting":{"zh":"大卫，今天怎么样？","english":"David, how is your day?","pinyin":"dà wèi ， jīn tiān zěn me yàng ？","audio":"game/audio/9dcbacf0b665790d1e32.m4a"}},"zhou":{"name":"Ms Zhou","role":"teahouse owner","portrait":{"asset":"game/art/50f24f287923-characters.webp","column":2,"columns":3},"greeting":{"zh":"大卫，欢迎回来！","english":"David, welcome back!","pinyin":"dà wèi ， huān yíng huí lái ！","audio":"game/audio/794111b5f0e6be913a54.m4a"}}},"locations":{"teahouse":{"name":"Teahouse","background":"game/art/d10672c8e469-courtyard.webp"}},"facts":{"lin-tea":{"character":"lin","line":{"zh":"我喜欢喝茶。","english":"Ms Lin enjoys tea.","pinyin":"wǒ xǐ huan hē chá 。","audio":"game/audio/ca69e7e18d1fe59bd676.m4a"}},"chen-books":{"character":"chen","line":{"zh":"我也喜欢看书。","english":"Chen also enjoys reading.","pinyin":"wǒ yě xǐ huan kàn shū 。","audio":"game/audio/e6bbe0e8d9019f92cce3.m4a"}}},"bonuses":{"lin-friendly":{"character":"lin","threshold":4,"title":"The escaped spring onion","narration":"Ms Lin points at her shopping bag. The spring onion is making another escape. She catches it and offers me a seat.","line":{"zh":"坐一下吧。我们聊聊天。","english":"Sit for a while. Let’s have a chat.","pinyin":"zuò yí xià ba 。 wǒ men liáo liáo tiān 。","audio":"game/audio/a77f6cff8bd1cad8e284.m4a"}},"chen-friendly":{"character":"chen","threshold":4,"title":"A book for next time","narration":"Chen has remembered that I am learning. He shows me a short book instead of the enormous one at the bottom of his stack.","line":{"zh":"这本书很有意思。下次给你看。","english":"This book is interesting. I’ll show you next time.","pinyin":"zhè běn shū hěn yǒu yì sī 。 xià cì gěi nǐ kàn 。","audio":"game/audio/875e6385153a86fc475b.m4a"}},"zhou-friendly":{"character":"zhou","threshold":4,"title":"My usual chair","narration":"Ms Zhou moves a chair into the afternoon shade before I ask. Becoming a regular seems to involve someone remembering where I like to sit.","line":{"zh":"还是坐这里吧。这里很舒服。","english":"Sit here again. It is comfortable here.","pinyin":"hái shì zuò zhè lǐ ba 。 zhè lǐ hěn shū fú 。","audio":"game/audio/f17afedbc6108ab34be5.m4a"}}},"milestones":{"known-name":{"title":"A neighbour knows my name"},"colleague-plan":{"title":"A plan with a colleague"},"familiar-table":{"title":"A familiar table"}},"goal":{"id":"familiar-face","title":"Familiar face","milestones":["known-name","colleague-plan","familiar-table"]}},"document":"game/episodes/teahouse/v4/index.html","resources":["game/episodes/teahouse/v4/index.html","game/art/d10672c8e469-courtyard.webp","game/audio/ad0d81911a4ad4c514a6.m4a","game/audio/281e5ee3c7bab8770e06.m4a","game/audio/72069022f25aeb8e393b.m4a","game/audio/331c31aca370b38e5b14.m4a","game/audio/f951e6f97a5ece211cbb.m4a","game/audio/9e9b8cc4dcedcb052f47.m4a","game/audio/13d853d7cd050b04a1ab.m4a","game/audio/b39f9dceb82a54383151.m4a","game/audio/a6d6367e5fb63b0c7dfe.m4a","game/audio/f86e34df821bda13cb84.m4a","game/audio/2602e6c7d2a94562b99d.m4a","game/audio/a65bbc3864b52e5a91e4.m4a","game/audio/a1f7fa7b03484fd9213b.m4a","game/audio/94d95e45fa089737e00d.m4a","game/audio/d2cf98c7fa8c6e642a20.m4a","game/audio/4bd7a3dcf9b700b7dc82.m4a","game/audio/1efda7758d760bf6ff88.m4a","game/audio/0f948cb978b2e7812101.m4a","game/art/50f24f287923-characters.webp","game/audio/339b8a93e23c5b5e542e.m4a","game/audio/9dcbacf0b665790d1e32.m4a","game/audio/794111b5f0e6be913a54.m4a","game/audio/a77f6cff8bd1cad8e284.m4a","game/audio/875e6385153a86fc475b.m4a","game/audio/f17afedbc6108ab34be5.m4a","game/audio/ca69e7e18d1fe59bd676.m4a","game/audio/e6bbe0e8d9019f92cce3.m4a","game/audio/9807810e843cc8028443.m4a","game/audio/f85fe237dad8ef917f9c.m4a","game/audio/4f7061bc3141bca12d95.m4a","game/audio/7941b1e60c0bf7bf99f0.m4a","game/audio/0082b9d7619ec67d8d23.m4a"]};
/* Presentation only. The parent owns identity, validation, audio and local saves. */
Config.history.maxStates = 1;
Config.history.controls = false;
Config.saves.isAllowed = () => false;
Config.ui.stowBarInitially = true;
Config.passages.nobr = true;
const channel = new URLSearchParams(location.hash.slice(1)).get('channel');
let snapshot = null;
let pending = false;
let order = [];
let settingsOpen = false;
let hotkeys = ['1','2','3','4','5','6'];
let playKey = 'p';
let progress = {xp:0,friendships:{},facts:[],milestones:[],unlocked:[],events:{}};
let speaking=null, transitioning=false, notebookOpen=false;
const asset = path => new URL('../../../../'+path,location.href).href;
const moves = () => snapshot?.motion && !matchMedia('(prefers-reduced-motion: reduce)').matches;
function send(type, payload = {}) {
  if (parent === window || !channel) return;
  parent.postMessage({protocol:'chunky-game-v1',channel,type,...payload},location.origin);
}
function act(type, extra = {}) { if(pending||transitioning)return;pending=true;send('action',{revision:snapshot.revision,action:{type,...extra}}); }
function el(tag, text, cls) { const n=document.createElement(tag); if(tag==='h1')n.tabIndex=-1; if(text!==undefined)n.textContent=text; if(cls)n.className=cls; return n; }
function button(label, fn, key) { const b=el('button',label); b.type='button'; b.onclick=fn; if(key)b.dataset.key=key; return b; }
function speak(audio,role='preview') { if(audio)send('audio',{audio,role}); }
function zhLine(line, root, role='npc') {
  const p=el('p',line.zh,'chinese'); p.lang='zh-CN'; root.append(p);
  if(snapshot.pinyin)root.append(el('p',line.pinyin,'pinyin'));
  root.append(button('▶ Hear Mandarin',()=>speak(line.audio,role),'hear'));
  root.append(button(snapshot.meaning?'Hide meaning':'Show meaning',()=>act('meaning'),'meaning'));
  if(snapshot.meaning)root.append(el('p',line.english,'translation'));
}
function portrait(root,speaker) {
  const ep=setup.episode,c=ep.world.characters[speaker];
  if(!c)return;
  const art=el('div',undefined,'scene-art');art.style.backgroundImage=`url("${asset(ep.world.locations[ep.location].background)}")`;
  const crop=el('div',undefined,'portrait-crop');crop.dataset.speaker=speaker;
  const img=el('img',undefined,'portrait');img.src=asset(c.portrait.asset);img.alt='';img.style.setProperty('--person',c.portrait.column);img.style.setProperty('--columns',c.portrait.columns);img.onerror=()=>img.remove();crop.append(img);
  art.append(crop,el('span',ep.place,'place'),el('span',c.name,'speaker-name'));root.append(art);
}
function motion() {document.querySelectorAll('.portrait-crop').forEach(n=>{n.classList.toggle('alive',!!moves());n.classList.toggle('speaking',!!moves()&&n.dataset.speaker===speaking)})}
function status(root,speaker) {
  const ep=setup.episode,w=ep.world,c=w.characters[speaker];
  const hud=el('div',undefined,'journey-hud');hud.append(el('span',`${progress.xp} Language XP`),el('span',c?`${c.name}: ${progress.friendships[speaker]||0} Friendship`:'Neighbourhood friendships'),el('span',`${progress.milestones.filter(id=>w.goal.milestones.includes(id)).length}/${w.goal.milestones.length} Belonging`));root.append(hud);
  const book=el('details',undefined,'people-book');book.open=notebookOpen;book.ontoggle=()=>{notebookOpen=book.open};book.append(el('summary','People I know'));
  Object.entries(w.characters).forEach(([id,c])=>{book.append(el('strong',`${c.name} · ${progress.friendships[id]||0} Friendship`));const facts=progress.facts.filter(f=>w.facts[f]?.character===id);if(!facts.length)book.append(el('p','Personal details appear here when you encounter them.'));facts.forEach(f=>{const line=w.facts[f].line;book.append(el('p',line.zh,'chinese'));if(snapshot.pinyin)book.append(el('p',line.pinyin,'pinyin'));book.append(el('p',line.english))})});root.append(book);
  if(snapshot.notice){const n=el('p',snapshot.notice,'reward-notice');n.setAttribute('role','status');root.append(n)}
}
function extras(root) {
 const ep=setup.episode,w=ep.world,a=snapshot,check=ep.memoryCheck;
 if(check){const box=el('section',undefined,'friendship-moment');box.append(el('h2','A little detail, remembered'));
 const event=`memory:${check.id}`;
 if(a.memoryEligible.includes(check.fact)){
   if(progress.events[event]===undefined){zhLine(check.question,box);box.append(el('p','Optional: recall a personal detail. The notebook is always available.'));
     check.options.forEach(o=>{const b=button(o.line.zh,()=>act('memory',{choiceId:o.id}),`memory-${o.id}`);if(a.pinyin)b.append(el('small',o.line.pinyin,'pinyin'));box.append(b)})
   }else if(progress.events[`${event}:repairable`]!==undefined&&progress.events[`${event}:repaired`]===undefined){box.append(el('p','Ms Lin enjoys tea. A friendly correction puts things right.'));const b=button(check.repair.zh,()=>act('repair'),'repair');if(a.pinyin)b.append(el('small',check.repair.pinyin,'pinyin'));box.append(b)}
   else box.append(el('p','This personal moment is remembered.'));
 }else {zhLine(check.introduction,box);if(!progress.facts.includes(check.fact))box.append(button('Remember this in my notebook',()=>act('learnFact'),'learnFact'));else box.append(el('p','Saved in People I know.'))}
 root.append(box)}
 Object.entries(w.bonuses).filter(([id])=>progress.unlocked.includes(id)).forEach(([id,b])=>root.append(button(`Friendship moment: ${b.title}`,()=>act('bonus',{choiceId:id}),`bonus-${id}`)));
}
function render(root) {
  root.replaceChildren();
  if (!snapshot) { root.append(el('p',parent===window?'Open this episode from Game in Chunky Chinese to save your progress.':'Opening your conversation…')); return; }
  const a=snapshot, ep=setup.episode, scene=ep.scenes[a.step];
  const bonus=a.bonusId&&ep.world.bonuses[a.bonusId];
  const speaker=bonus?.character||scene?.speaker||ep.memoryCheck?.speaker||ep.participants[0];
  portrait(root,speaker);status(root,speaker);
  if(bonus){const panel=el('section',undefined,'dialogue');panel.append(el('h1',bonus.title),el('p',bonus.narration));zhLine(bonus.line,panel);panel.append(button('Back to the afternoon',()=>act('closeBonus'),'closeBonus'));root.append(panel);motion();return;}
  if(!scene) {
    root.append(el('p','EPISODE COMPLETE','eyebrow'),el('h1','Things I can now say'),el('p',ep.ending));
    a.results.forEach((r,i)=>{const c=ep.scenes[i].choices.find(c=>c.id===r.choiceId),ans=c[a.variant];const card=el('section',undefined,'receipt');const line=el('p',ans.chunks.join(''),'chinese');line.lang='zh-CN';card.append(line,el('p',ans.english),el('small',r.independent?'Independently':'With support'),button('▶ Hear my sentence',()=>speak(ans.audio)));root.append(card)});
    extras(root);motion();
    root.append(el('p','Recognition guides difficulty; these conversations do not change your flashcard ratings.'),button('Back to Game',()=>send('exit'),'exit'));
    return;
  }
  const char=ep.world.characters[scene.speaker];
  const c=scene.choices.find(c=>c.id===a.choiceId);
  const panel=el('section',undefined,'dialogue');
  panel.append(el('p',`${a.step+1} / ${ep.scenes.length} · ${char.name} · ${char.role}`,'eyebrow'));
  if(a.step===0&&progress.unlocked.some(id=>ep.world.bonuses[id]?.character===scene.speaker)){const greeting=el('p',char.greeting.zh,'callback');if(a.pinyin)greeting.append(el('small',char.greeting.pinyin,'pinyin'));panel.append(greeting)}
  const heading=el('h1',scene.title);heading.tabIndex=-1;panel.append(heading);
  if(scene.callback && a.callbacks.includes(scene.callback.flag))panel.append(el('p',scene.callback.text,'callback'));
  // Assistive technology gets the full narrative immediately; visual pacing is optional.
  if(a.paragraph>=scene.paragraphs.length){const moment=el('details');moment.append(el('summary','Recall this moment'),el('p',scene.paragraphs.join(' ')));panel.append(moment)}
  else {const sr=el('div',scene.paragraphs.join(' '),'sr-only');panel.append(sr);
  scene.paragraphs.slice(0,a.paragraph+1).forEach(t=>{const p=el('p',t);p.setAttribute('aria-hidden','true');panel.append(p)})}
  if(a.paragraph<scene.paragraphs.length) {
    panel.append(button('Next',()=>act('reveal'),'next'),button('Show all',()=>act('showAll'),'showAll'));root.append(panel);motion();return;
  }
  if(scene.promptMode==='listen' && !a.transcript && !a.solved){
    const listen=el('section',undefined,'listening-prompt');listen.append(el('p','Listen closely…','chinese'),button(a.heard?'▶ Replay':'▶ Listen',()=>speak(scene.line.audio,'npc'),'hear'),button('Show transcript',()=>act('transcript'),'transcript'));
    listen.append(el('p',a.heard?'Choose the reply that fits. You can replay as often as you like.':'Listen to the full question, then choose a reply. Or use Show transcript for support.'));panel.append(listen);
  } else zhLine(scene.line,panel);
  const settings=el('details',undefined,'settings');settings.open=settingsOpen;settings.ontoggle=()=>{settingsOpen=settings.open};settings.append(el('summary','Game settings'),button(a.pinyin?'Pinyin: on':'Pinyin: off',()=>act('pinyin'),'pinyin'),button(a.clues?'English clues: on':'English clues: off',()=>act('clues'),'clues'),button(a.motion?'Motion: on':'Motion: off',()=>act('motion'),'motion'));panel.append(settings);
  if(a.clues)panel.append(el('p',scene.clue,'goal-clue'));
  else if(!a.solved && scene.kind==='choice')panel.append(button('Hint',()=>act('hint'),'hint'));
  const recall=el('div');
  a.results.forEach((r,i)=>{const s=ep.scenes[i],c=s.choices.find(c=>c.id===r.choiceId);recall.append(el('p',`${s.line.zh} — ${c[a.variant].chunks.join('')}`),el('p',c.responseLine?.zh||c.response))});
  if(!a.results.length)recall.append(el('p',scene.paragraphs.join(' ')));
  if(scene.kind==='choice') {
    const responses=el('div',undefined,'reply-options');
    order.forEach((id,pos)=>{const option=scene.options[id];if(!option)return;const card=el('div',undefined,'reply-option');const b=button('',()=>act('answer',{choiceId:option.id}),`option-${id}`);b.disabled=a.solved||(scene.promptMode==='listen'&&!a.heard&&!a.transcript);b.dataset.shortcut=hotkeys[pos]||String(pos+1);b.append(el('small',String(pos+1)),el('span',option[a.variant],'chinese'));b.lang='zh-CN';if(a.pinyin)b.append(el('span',option[`${a.variant}Pinyin`],'pinyin'));card.append(b,button('▶',()=>speak(option[`${a.variant}Audio`]),`listen-${id}`));card.lastChild.setAttribute('aria-label',`Hear response ${pos+1}`);responses.append(card)});panel.append(responses);
  } else if(c) {
    const answer=c[a.variant], chunks=[...answer.chunks,...(answer.distractors||[])], pinyin=[...answer.pinyin,...(answer.distractorPinyin||[])];
    const selected=el('div',undefined,'sentence');selected.setAttribute('aria-label','My sentence');
    a.tiles.forEach((id,pos)=>{const b=button(chunks[id],()=>act('remove',{index:pos}),`remove-${pos}`);b.lang='zh-CN';b.disabled=a.solved;b.setAttribute('aria-label',`Remove ${chunks[id]}`);selected.append(b)});
    if(!a.tiles.length)selected.append(el('span','Tap chunks below to build your reply.','empty'));panel.append(selected);
    const bank=el('div',undefined,'chunks');bank.setAttribute('aria-label','Available chunks');
    order.forEach((id,pos)=>{const b=button('',()=>act('tile',{index:id}),`tile-${id}`);b.disabled=a.tiles.includes(id)||a.solved;b.dataset.shortcut=hotkeys[pos]||String(pos+1);b.append(el('small',String(pos+1)),el('span',chunks[id]));b.lang='zh-CN';if(a.pinyin)b.append(el('small',pinyin[id]));bank.append(b)});panel.append(bank);
    const controls=el('div',undefined,'controls');
    if(!a.solved) {
      controls.append(button('Undo',()=>act('undo'),'undo'),button('Clear',()=>act('clear'),'clear'),button('Hint',()=>act('hint'),'hint'),button('Check',()=>act('check'),'check'));
      if(a.errors>=2)controls.append(button('Show worked answer',()=>act('model'),'model'));
    }
    panel.append(controls);
    panel.append(el('small','Choose only the chunks you need. Extra chunks can stay in the bank.','keyboard-help'));
  }
  if(a.feedback){const f=el('p',a.feedback,'feedback');f.setAttribute('role','status');panel.append(f)}
  if(a.solved && c){
    const answer=c[a.variant], response=el('section',undefined,'response');
    if(c.responseLine){response.lang='zh-CN';response.append(el('p',c.responseLine.zh,'chinese'));if(a.pinyin)response.append(el('p',c.responseLine.pinyin,'pinyin'));response.append(button('▶ Hear their reply',()=>speak(c.responseLine.audio,'npc'),'response-audio'));if(a.meaning)response.append(el('p',c.responseLine.english));}
    panel.append(response,button('▶ Hear my reply',()=>speak(answer.audio),'reply'),button(a.step===ep.scenes.length-1?'Finish episode':'Continue',()=>act('next'),'continue'));
  }
  const more=el('details');more.append(el('summary','Recall the conversation'),recall);panel.append(more);
  root.append(panel);motion();
}
Macro.add('chengduScene',{handler:function(){const root=el('main',undefined,'chengdu');this.output.append(root);render(root)}});
window.addEventListener('message',event=>{
  const m=event.data;
  if(event.source!==parent||event.origin!==location.origin||m?.protocol!=='chunky-game-v1'||m.channel!==channel )return;
  if(m.type==='playback'){if(m.attemptId===snapshot?.attemptId&&m.step===snapshot?.step){speaking=typeof m.speaker==='string'?m.speaker:null;motion()}return}
  if(m.type!=='state'||!m.state||m.state.episodeId!==setup.episode.id||m.state.version!==setup.episode.version)return;
  pending=false;
  const before=snapshot;
  snapshot=m.state;
  if(m.progress)progress=m.progress;
  order=Array.isArray(m.order)?m.order:[];
  if(Array.isArray(m.hotkeys))hotkeys=m.hotkeys;
  if(typeof m.playKey==='string')playKey=m.playKey;
  const passage=snapshot.step===setup.episode.scenes.length?'Ending':`Scene${snapshot.step+1}`;
  const focusKey=document.activeElement?.dataset?.key;
  const sceneChanged=before&&(before.step!==snapshot.step||before.bonusId!==snapshot.bonusId);
  if(sceneChanged)speaking=null;
  if(State.passage!==passage)Engine.play(passage);
  else {const root=document.querySelector('.chengdu');if(root)render(root)}
  motion();
  if(sceneChanged&&moves()){transitioning=true;const root=document.querySelector('.chengdu');root.inert=true;const controls=Array.from(root.querySelectorAll('button')).map(b=>[b,b.disabled]);controls.forEach(([b])=>b.disabled=true);const fade=root.animate([{opacity:0},{opacity:1}],{duration:200});const finish=()=>{transitioning=false;root.inert=false;controls.forEach(([b,disabled])=>b.disabled=disabled);document.querySelector('.chengdu h1')?.focus({preventScroll:true})};fade.onfinish=finish;fade.oncancel=finish}
  if(before && (before.step!==snapshot.step || (!before.choiceId && snapshot.choiceId)))window.scrollTo(0,0);
  if(before){const controls=Array.from(document.querySelectorAll('button'));const focus=controls.find(b=>b.dataset.key===focusKey&&!b.disabled)||controls.find(b=>b.dataset.key==='continue')||controls.find(b=>b.dataset.shortcut&&!b.disabled)||document.querySelector('.chengdu h1');focus?.focus({preventScroll:true})}
});
window.addEventListener('keydown',event=>{
  if(event.ctrlKey||event.metaKey||event.altKey||event.repeat||!snapshot||transitioning)return;
  if(event.key.toLowerCase()===playKey.toLowerCase()){event.preventDefault();speak(snapshot.bonusId?setup.episode.world.bonuses[snapshot.bonusId]?.line.audio:setup.episode.scenes[snapshot.step]?.line.audio,'npc');return}
  const b=Array.from(document.querySelectorAll('button[data-shortcut]')).find(b=>b.dataset.shortcut?.toLowerCase()===event.key.toLowerCase()&&!b.disabled);
  if(b){event.preventDefault();b.click()}
});
matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change',()=>{motion();if(!moves())document.getAnimations().forEach(a=>a.finish())});
$(document).one(':storyready',()=>send('ready'));


:: StoryStylesheet [stylesheet]
:root{color-scheme:light;font-family:system-ui,sans-serif;color:#253b32;background:#f5efdf}body{margin:0;background:#f5efdf;color:#253b32}#ui-bar,#story-title{display:none}#story{margin:0;padding:0}#passages{max-width:820px;margin:auto}.passage{padding:0}.chengdu{padding:0 0 24px}.scene-art{height:205px;position:relative;background:#b9c9a3 url('courtyard.webp') center 52%/cover;image-rendering:pixelated;border-bottom:5px solid #37654a;overflow:hidden}.portrait-crop{position:absolute;width:97px;height:194px;bottom:0;right:12%;overflow:hidden}.portrait{height:194px;width:291px;max-width:none;position:absolute;left:calc(var(--person) * -97px);image-rendering:pixelated}.place{position:absolute;left:18px;top:18px;background:#183d30;color:#fff6df;padding:8px 15px;border:2px solid #dbba75;font-weight:700}.dialogue,.chengdu>h1,.chengdu>p,.receipt{margin:0;padding:18px 24px}.dialogue p{line-height:1.65;margin:10px 0}.eyebrow{font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#456251}.dialogue h1,.chengdu>h1{font-size:25px;line-height:1.2;margin:10px 0 18px}h2{font-size:18px;margin-top:22px}.chinese{font-size:25px!important;line-height:1.6!important;font-family:system-ui,sans-serif}.pinyin{color:#625540;font-size:15px}.translation,.intention{color:#52634f}.callback{border-left:3px solid #c19850;padding:8px 12px;background:#efe4c9}button{font:inherit;min-height:44px;color:#254332;background:#fffdf7;border:2px solid #9ba991;border-radius:8px;padding:9px 13px;margin:4px;cursor:pointer;box-shadow:0 2px 0 #c9c5b4}button:hover{background:#eee8cc;border-color:#446e4e}button:focus-visible,summary:focus-visible{outline:3px solid #b46a27;outline-offset:3px}button:disabled{opacity:.4;cursor:default}button[data-key=check],button[data-key=continue],button[data-key=next]{background:#285d42;color:#fff;border-color:#285d42}.sentence{display:flex;gap:4px;align-items:center;flex-wrap:wrap;min-height:72px;background:#eee7d4;border:2px dashed #a2ad94;border-radius:12px;padding:9px;margin:12px 0}.sentence button{font-size:23px;margin:2px}.empty{font-size:14px;color:#6b745f}.chunks{display:flex;flex-wrap:wrap;gap:5px}.chunks button{display:flex;flex-direction:column;align-items:center;min-width:68px;font-size:23px}.chunks small{font-size:12px;color:#59654b}.feedback{background:#e7ead7;padding:12px;border-radius:8px}.response{border-left:4px solid #b9853a;padding:12px}.aside{margin-top:16px}details{margin:12px 0;font-size:14px}summary{cursor:pointer;min-height:32px}.receipt{border-top:1px solid #c5cab8}.receipt small{display:inline-block;color:#47624a}.keyboard-help{display:block;color:#68715f;margin-top:14px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:460px){.dialogue{padding:16px}.scene-art{height:165px}.portrait-crop{right:8%;height:154px;width:77px}.portrait{height:154px;width:231px;left:calc(var(--person) * -77px)}.dialogue h1{font-size:22px}.chunks button{font-size:21px;padding:8px;min-width:56px}.keyboard-help{display:none}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

.scene-art{position:sticky;top:0;z-index:2}.dialogue>button{font-size:13px;padding:8px 10px}.dialogue details{margin:6px 0}.dialogue h1{margin-bottom:10px}@media(max-width:460px){.scene-art{height:125px}.portrait-crop{height:120px;width:60px}.portrait{height:120px;width:180px;left:calc(var(--person) * -60px)}.dialogue{padding:12px 16px}.dialogue h1{font-size:20px}.dialogue p{margin:6px 0}.dialogue h2{margin-top:14px}.place{padding:5px 10px;top:12px;left:12px;font-size:12px}}

/* SugarCube’s stowed sidebar otherwise reserves a left gutter on phones. */
#story,#ui-bar.stowed~#story{margin:0!important;padding:0!important}#passages{width:100%;box-sizing:border-box}#ui-bar-tray{display:none!important}
/* Keep the speaker close: enlarge and crop the existing original character atlas at the waist. */
.scene-art{height:220px;position:relative}.portrait-crop{width:240px;height:210px;right:calc(50% - 120px);bottom:0}.portrait{width:720px;height:480px;left:calc(var(--person) * -240px);top:0}.dialogue h1{font-size:16px;color:#57634e}.dialogue>.chinese{font-size:30px!important;margin-top:12px}.goal-clue{border-left:3px solid #b9853a;padding:8px 12px;background:#eee5cc;font-size:14px}.reply-options{display:grid;gap:10px;margin:16px 0}.reply-option{display:flex;gap:4px}.reply-option>button:first-child{flex:1;text-align:left;display:flex;flex-direction:column;gap:4px;padding:12px 16px;margin:0}.reply-option>button:last-child{align-self:center;min-width:44px}.reply-option .chinese{font-size:24px!important}.reply-option small{font-size:12px}.settings{font-size:13px}.response{margin-top:16px}.dialogue>details:first-of-type{color:#59654b}@media(min-width:700px){.reply-options{grid-template-columns:repeat(3,1fr)}.reply-option{flex-direction:column}.reply-option>button:first-child{width:100%}.reply-option>button:last-child{align-self:flex-end}}@media(max-width:460px){.scene-art{height:165px}.portrait-crop{width:180px;height:160px;right:calc(50% - 90px)}.portrait{width:540px;height:360px;left:calc(var(--person) * -180px)}.place{font-size:11px;max-width:100px}.dialogue>.chinese{font-size:26px!important}.dialogue h1{font-size:15px}.pinyin{font-size:14px}.reply-option .chinese{font-size:23px!important}}
/* Shared portrait atlas metadata and subtle, optional life. */
.portrait-crop{--portrait-width:240px;overflow:hidden}.portrait{width:calc(var(--columns) * var(--portrait-width));left:calc(var(--person) * var(--portrait-width) * -1)}
.portrait-crop.alive{animation:portrait-bob 3.8s ease-in-out infinite}.portrait-crop.speaking{animation:portrait-talk .42s ease-in-out infinite alternate}
@keyframes portrait-bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}@keyframes portrait-talk{from{transform:translateY(0)}to{transform:translateY(-3px)}}
.speaker-name{position:absolute;bottom:8px;left:16px;background:#fff5dc;padding:5px 9px;border-radius:4px;font-weight:700}.journey-hud{display:flex;flex-wrap:wrap;gap:8px 18px;padding:10px 20px;background:#e6e4ce;font-size:12px;font-weight:700}.people-book{margin:8px 24px}.people-book strong{display:block;margin-top:12px}.reward-notice{padding:10px 24px!important;background:#e6ead3;font-size:13px}.friendship-moment{padding:18px 24px;background:#eee5ce}.friendship-moment small,.callback small{display:block}.friendship-moment button{max-width:100%}.chengdu>button{margin-left:24px}
@media(max-width:460px){.portrait-crop{--portrait-width:180px}.journey-hud{padding:8px 16px;font-size:11px;gap:4px 12px}.people-book{margin:8px 16px}}


