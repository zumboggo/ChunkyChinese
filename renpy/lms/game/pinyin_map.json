{"lines":{"旧账号":["jiù","zhàng","hào"],"狭窄房间外的光":["xiá","zhǎi","fáng","jiān","wài","de","guāng"],"第一课：先别装高手":["dì","yī","kè",null,"xiān","bié","zhuāng","gāo","shǒu"],"被妹妹看见的手":["bèi","mèi","mei","kàn","jiàn","de","shǒu"],"稻草人":["dào","cǎo","rén"],"最后一个人":["zuì","hòu","yí","gè","rén"],"雕刻师的路":["diāo","kè","shī","de","lù"],"李贤":["lǐ","xián"],"妹妹":["mèi","mei"],"奶奶":["nǎi","nai"],"老人":["lǎo","rén"],"（浪漫结局占位：李贤选择了人。）":[null,"làng","màn","jié","jú","zhàn","wèi",null,"lǐ","xián","xuǎn","zé","le","rén",null,null],"（财富结局占位：李贤选择了安稳。）":[null,"cái","fù","jié","jú","zhàn","wèi",null,"lǐ","xián","xuǎn","zé","le","ān","wěn",null,null],"（终极结局占位：李贤选择了登顶。）":[null,"zhōng","jí","jié","jú","zhàn","wèi",null,"lǐ","xián","xuǎn","zé","le","dēng","dǐng",null,null],"我没事。":["wǒ","méi","shì",null],"。，、；：？！…—·～〜（）《》〈〉「」『』“”‘’":[null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null],"月光雕刻师":["yuè","guāng","diāo","kè","shī"],"·":[null],"开":["kāi"],"关":["guān"],"拼音":["pīn","yīn"],"英文":["yīng","wén"],"读取":["dú","qǔ"],"设置":["shè","zhì"],"退出":["tuì","chū"],"—":[null],"李贤家里一直没有很多钱。":["lǐ","xián","jiā","lǐ","yì","zhí","méi","yǒu","hěn","duō","qián",null],"白天，他在加油站工作。晚上，他回家以后，还要照顾奶奶和妹妹。":["bái","tiān",null,"tā","zài","jiā","yóu","zhàn","gōng","zuò",null,"wǎn","shàng",null,"tā","huí","jiā","yǐ","hòu",null,"hái","yào","zhào","gù","nǎi","nai","hé","mèi","mei",null],"奶奶身体不好，最近常常生病。":["nǎi","nai","shēn","tǐ","bù","hǎo",null,"zuì","jìn","cháng","cháng","shēng","bìng",null],"妹妹虽然不说，可是李贤看得出来，她每天都在担心家里的钱。":["mèi","mei","suī","rán","bù","shuō",null,"kě","shì","lǐ","xián","kàn","dé","chū","lái",null,"tā","měi","tiān","dōu","zài","dān","xīn","jiā","lǐ","de","qián",null],"李贤自己也很急，可是他不喜欢把":["lǐ","xián","zì","jǐ","yě","hěn","jí",null,"kě","shì","tā","bù","xǐ","huan","bǎ"],"我很难":["wǒ","hěn","nán"],"放在脸上。":["fàng","zài","liǎn","shàng",null],"他还有一个旧游戏账号。那个账号陪了他很久。":["tā","hái","yǒu","yí","gè","jiù","yóu","xì","zhàng","hào",null,"nà","ge","zhàng","hào","péi","le","tā","hěn","jiǔ",null],"以前他最难过的时候，他常常打开电脑，看着那个账号，心里会安静一点。":["yǐ","qián","tā","zuì","nán","guò","de","shí","hòu",null,"tā","cháng","cháng","dǎ","kāi","diàn","nǎo",null,"kàn","zhe","nà","ge","zhàng","hào",null,"xīn","lǐ","huì","ān","jìng","yì","diǎn",null],"那个旧账号对李贤来说意味着什么？":["nà","ge","jiù","zhàng","hào","duì","lǐ","xián","lái","shuō","yì","wèi","zhe","shén","me",null],"是他最后一点希望。":["shì","tā","zuì","hòu","yì","diǎn","xī","wàng",null],"只是一个游戏，没什么特别的。":["zhǐ","shì","yí","gè","yóu","xì",null,"méi","shén","me","tè","bié","de",null],"浪费时间的东西，早该删了。":["làng","fèi","shí","jiān","de","dōng","xī",null,"zǎo","gāi","shān","le",null],"对。在他心里，那个账号不只是钱，也是他最后一点希望。他一直告诉自己，只要这个账号还在，他就不算什么都没有。":["duì",null,"zài","tā","xīn","lǐ",null,"nà","ge","zhàng","hào","bù","zhǐ","shì","qián",null,"yě","shì","tā","zuì","hòu","yì","diǎn","xī","wàng",null,"tā","yì","zhí","gào","sù","zì","jǐ",null,"zhǐ","yào","zhè","ge","zhàng","hào","hái","zài",null,"tā","jiù","bú","suàn","shén","me","dōu","méi","yǒu",null],"不完全是这样。那个账号不只是游戏，也不只是钱。它是李贤告诉自己":["bù","wán","quán","shì","zhè","yàng",null,"nà","ge","zhàng","hào","bù","zhǐ","shì","yóu","xì",null,"yě","bù","zhǐ","shì","qián",null,"tā","shì","lǐ","xián","gào","sù","zì","jǐ"],"我还没有输":["wǒ","hái","méi","yǒu","shū"],"的方式。":["de","fāng","shì",null],"可是有一天晚上，奶奶又病了。":["kě","shì","yǒu","yì","tiān","wǎn","shàng",null,"nǎi","nai","yòu","bìng","le",null],"妹妹小声问他：":["mèi","mei","xiǎo","shēng","wèn","tā",null],"明天买药的钱在哪里？":["míng","tiān","mǎi","yào","de","qián","zài","nǎ","lǐ",null],"李贤没有马上回答。他看着桌子上的卡，又看着房间里的奶奶，心里很乱。":["lǐ","xián","méi","yǒu","mǎ","shàng","huí","dá",null,"tā","kàn","zhe","zhuō","zi","shàng","de","kǎ",null,"yòu","kàn","zhe","fáng","jiān","lǐ","de","nǎi","nai",null,"xīn","lǐ","hěn","luàn",null],"一个声音说：":["yí","gè","shēng","yīn","shuō",null],"不能卖。卖了以后，你就真的什么都没有了。":["bù","néng","mài",null,"mài","le","yǐ","hòu",null,"nǐ","jiù","zhēn","de","shén","me","dōu","méi","yǒu","le",null],"另一个声音说：":["lìng","yí","gè","shēng","yīn","shuō",null],"如果不卖，家里怎么办？":["rú","guǒ","bú","mài",null,"jiā","lǐ","zěn","me","bàn",null],"他坐了很久，才慢慢明白，自己一直舍不得的不是游戏本身，而是那个":["tā","zuò","le","hěn","jiǔ",null,"cái","màn","màn","míng","bái",null,"zì","jǐ","yì","zhí","shè","bù","dé","de","bú","shì","yóu","xì","běn","shēn",null,"ér","shì","nà","ge"],"的感觉。":["de","gǎn","jué",null],"第二天，他去把旧账号卖了，把钱带回家。":["dì","èr","tiān",null,"tā","qù","bǎ","jiù","zhàng","hào","mài","le",null,"bǎ","qián","dài","huí","jiā",null],"奶奶先愣了一下，然后轻轻笑了。":["nǎi","nai","xiān","lèng","le","yí","xià",null,"rán","hòu","qīng","qīng","xiào","le",null],"妹妹也终于松了一口气。":["mèi","mei","yě","zhōng","yú","sōng","le","yì","kǒu","qì",null],"李贤心里还是有点空，可是那种空没有让他更怕。相反，他第一次觉得自己更稳了。":["lǐ","xián","xīn","lǐ","hái","shì","yǒu","diǎn","kōng",null,"kě","shì","nà","zhǒng","kōng","méi","yǒu","ràng","tā","gèng","pà",null,"xiāng","fǎn",null,"tā","dì","yī","cì","jué","de","zì","jǐ","gèng","wěn","le",null],"他知道，真正让人安心的，不是手里留着什么东西，而是自己愿意为了家里去做对的事。":["tā","zhī","dào",null,"zhēn","zhèng","ràng","rén","ān","xīn","de",null,"bú","shì","shǒu","lǐ","liú","zhe","shén","me","dōng","xī",null,"ér","shì","zì","jǐ","yuàn","yì","wèi","le","jiā","lǐ","qù","zuò","duì","de","shì",null],"李贤卖掉了旧游戏账号，换来奶奶的药费。他失去了一样东西，却找到了更稳的自己。":["lǐ","xián","mài","diào","le","jiù","yóu","xì","zhàng","hào",null,"huàn","lái","nǎi","nǎi","de","yào","fèi",null,"tā","shī","qù","le","yí","yàng","dōng","xī",null,"què","zhǎo","dào","le","gèng","wěn","de","zì","jǐ",null],"那天晚上，李贤比平常更晚回家。":["nà","tiān","wǎn","shàng",null,"lǐ","xián","bǐ","píng","cháng","gèng","wǎn","huí","jiā",null],"他一开门，就先把手放到背后。":["tā","yì","kāi","mén",null,"jiù","xiān","bǎ","shǒu","fàng","dào","bèi","hòu",null],"妹妹马上看了他一眼。":["mèi","mei","mǎ","shàng","kàn","le","tā","yì","yǎn",null],"她只问：":["tā","zhī","wèn",null],"今天很累吗？":["jīn","tiān","hěn","lèi","ma",null],"李贤要怎么回答？":["lǐ","xián","yào","zěn","me","huí","dá",null],"笑一下，说自己只是和箱子打架。":["xiào","yí","xià",null,"shuō","zì","jǐ","zhǐ","shì","hé","xiāng","zǐ","dǎ","jià",null],"安静一点，只说今天有点累。":["ān","jìng","yì","diǎn",null,"zhī","shuō","jīn","tiān","yǒu","diǎn","lèi",null],"说":["shuō"],"没事":["méi","shì"],"，然后快点回房间。":[null,"rán","hòu","kuài","diǎn","huí","fáng","jiān",null],"李贤笑着说：":["lǐ","xián","xiào","zhe","shuō",null],"没事，今天只是和几个箱子打架，我赢了。":["méi","shì",null,"jīn","tiān","zhǐ","shì","hé","jǐ","gè","xiāng","zǐ","dǎ","jià",null,"wǒ","yíng","le",null],"他把声音放轻，只说：":["tā","bǎ","shēng","yīn","fàng","qīng",null,"zhī","shuō",null],"今天有点累，但没事。":["jīn","tiān","yǒu","diǎn","lèi",null,"dàn","méi","shì",null],"其实他今天搬了很多东西。手上有两处小小的擦伤。右手还有一个新的伤口。":["qí","shí","tā","jīn","tiān","bān","le","hěn","duō","dōng","xī",null,"shǒu","shàng","yǒu","liǎng","chù","xiǎo","xiǎo","de","cā","shāng",null,"yòu","shǒu","hái","yǒu","yí","gè","xīn","de","shāng","kǒu",null],"在他心里，家里已经很难了。如果连他也看起来很累，妹妹一定会更怕。":["zài","tā","xīn","lǐ",null,"jiā","lǐ","yǐ","jīng","hěn","nán","le",null,"rú","guǒ","lián","tā","yě","kàn","qǐ","lái","hěn","lèi",null,"mèi","mei","yí","dìng","huì","gèng","pà",null],"所以他一直有一个习惯。不管多痛，都先说":["suǒ","yǐ","tā","yì","zhí","yǒu","yí","gè","xí","guàn",null,"bù","guǎn","duō","tòng",null,"dōu","xiān","shuō"],"。":[null],"妹妹去拿水的时候，李贤想快点回房间。可是他一转身，手还是碰到了门边。":["mèi","mei","qù","ná","shuǐ","de","shí","hòu",null,"lǐ","xián","xiǎng","kuài","diǎn","huí","fáng","jiān",null,"kě","shì","tā","yì","zhuǎn","shēn",null,"shǒu","hái","shì","pèng","dào","le","mén","biān",null],"他马上吸了一口气。妹妹听见声音，立刻走了过来。":["tā","mǎ","shàng","xī","le","yì","kǒu","qì",null,"mèi","mei","tīng","jiàn","shēng","yīn",null,"lì","kè","zǒu","le","guò","lái",null],"她看见他的手，脸一下子白了。":["tā","kàn","jiàn","tā","de","shǒu",null,"liǎn","yí","xià","zǐ","bái","le",null],"她小声说：":["tā","xiǎo","shēng","shuō",null],"哥哥，你为什么不早说？":["gē","ge",null,"nǐ","wèi","shén","me","bù","zǎo","shuō",null],"李贤本来还想笑一下。可是他看见妹妹的眼睛，突然说不出话。":["lǐ","xián","běn","lái","hái","xiǎng","xiào","yí","xià",null,"kě","shì","tā","kàn","jiàn","mèi","mei","de","yǎn","jīng",null,"tū","rán","shuō","bù","chū","huà",null],"他第一次想到，也许自己一直这样逞强，并没有让妹妹放心。也许妹妹最怕的，不是伤口。妹妹最怕的是，哥哥什么都不说。":["tā","dì","yí","cì","xiǎng","dào",null,"yě","xǔ","zì","jǐ","yì","zhí","zhè","yàng","chěng","qiáng",null,"bìng","méi","yǒu","ràng","mèi","mei","fàng","xīn",null,"yě","xǔ","mèi","mei","zuì","pà","de",null,"bú","shì","shāng","kǒu",null,"mèi","mei","zuì","pà","de","shì",null,"gē","ge","shén","me","dōu","bù","shuō",null],"李贤慢慢坐下，把手伸出来。他说：":["lǐ","xián","màn","màn","zuò","xià",null,"bǎ","shǒu","shēn","chū","lái",null,"tā","shuō",null],"今天真的有一点痛。":["jīn","tiān","zhēn","de","yǒu","yì","diǎn","tòng",null],"妹妹没有哭。她只是去拿药，又认真帮他包扎。":["mèi","mei","méi","yǒu","kū",null,"tā","zhǐ","shì","qù","ná","yào",null,"yòu","rèn","zhēn","bāng","tā","bāo","zā",null],"包扎完以后，她说：":["bāo","zā","wán","yǐ","hòu",null,"tā","shuō",null],"下次早点告诉我。":["xià","cì","zǎo","diǎn","gào","sù","wǒ",null],"李贤点了点头。那天晚上，他还是很累。可是他的心比平常更安静。":["lǐ","xián","diǎn","le","diǎn","tóu",null,"nà","tiān","wǎn","shàng",null,"tā","hái","shì","hěn","lèi",null,"kě","shì","tā","de","xīn","bǐ","píng","cháng","gèng","ān","jìng",null],"他终于明白，保护家里的人，不一定是什么都自己藏起来。":["tā","zhōng","yú","míng","bái",null,"bǎo","hù","jiā","lǐ","de","rén",null,"bù","yí","dìng","shì","shén","me","dōu","zì","jǐ","cáng","qǐ","lái",null],"妹妹看见了李贤的手，也看见了他一直藏起来的痛。李贤学会了一件事：保护家人，不一定要什么都自己扛。":["mèi","mèi","kàn","jiàn","le","lǐ","xián","de","shǒu",null,"yě","kàn","jiàn","le","tā","yì","zhí","cáng","qǐ","lái","de","tòng",null,"lǐ","xián","xué","huì","le","yí","jiàn","shì",null,"bǎo","hù","jiā","rén",null,"bù","yí","dìng","yào","shén","me","dōu","zì","jǐ","káng",null],"杂草进入皇家之路以后，没有先去找热闹的地方，也没有急着去做简单任务。":["zá","cǎo","jìn","rù","huáng","jiā","zhī","lù","yǐ","hòu",null,"méi","yǒu","xiān","qù","zhǎo","rè","nào","de","dì","fāng",null,"yě","méi","yǒu","jí","zhe","qù","zuò","jiǎn","dān","rèn","wu",null],"他一到塞拉堡城，就先走进训练场。别的新手看了一圈，打几下训练稻草人，很快就走了。":["tā","yí","dào","sāi","lā","bǎo","chéng",null,"jiù","xiān","zǒu","jìn","xùn","liàn","chǎng",null,"bié","de","xīn","shǒu","kàn","le","yì","quān",null,"dǎ","jǐ","xià","xùn","liàn","dào","cǎo","rén",null,"hěn","kuài","jiù","zǒu","le",null],"有人去市场，有人去找队友，还有人笑杂草。他们问：":["yǒu","rén","qù","shì","chǎng",null,"yǒu","rén","qù","zhǎo","duì","yǒu",null,"hái","yǒu","rén","xiào","zá","cǎo",null,"tā","men","wèn",null],"你一直打这个木头人，要打到什么时候？":["nǐ","yì","zhí","dǎ","zhè","ge","mù","tou","rén",null,"yào","dǎ","dào","shén","me","shí","hòu",null],"杂草没有回话，只是继续拿着木剑，一下一下地打。":["zá","cǎo","méi","yǒu","huí","huà",null,"zhǐ","shì","jì","xù","ná","zhe","mù","jiàn",null,"yí","xià","yi","xià","dì","dǎ",null],"杂草为什么要一直打稻草人？":["zá","cǎo","wèi","shén","me","yào","yì","zhí","dǎ","dào","cǎo","rén",null],"因为他很生气，想打东西。":["yīn","wèi","tā","hěn","shēng","qì",null,"xiǎng","dǎ","dōng","xī",null],"因为他想变强，比别人更苦、更久。":["yīn","wèi","tā","xiǎng","biàn","qiáng",null,"bǐ","bié","rén","gèng","kǔ",null,"gèng","jiǔ",null],"因为他没有别的事做。":["yīn","wèi","tā","méi","yǒu","bié","de","shì","zuò",null],"不完全是。杂草心里一直有一个想法：自己开始得太晚，钱也不多，运气也不会特别好。如果不比别人更苦、更久、更能忍，以后一定还是弱的人。":["bù","wán","quán","shì",null,"zá","cǎo","xīn","lǐ","yì","zhí","yǒu","yí","gè","xiǎng","fǎ",null,"zì","jǐ","kāi","shǐ","dé","tài","wǎn",null,"qián","yě","bù","duō",null,"yùn","qì","yě","bú","huì","tè","bié","hǎo",null,"rú","guǒ","bù","bǐ","bié","rén","gèng","kǔ",null,"gèng","jiǔ",null,"gèng","néng","rěn",null,"yǐ","hòu","yí","dìng","hái","shì","ruò","de","rén",null],"对。在杂草心里，这很重要。他一直有一个想法：自己开始得太晚，钱也不多。如果不比别人更苦、更久、更能忍，以后一定还是弱的人。":["duì",null,"zài","zá","cǎo","xīn","lǐ",null,"zhè","hěn","zhòng","yào",null,"tā","yì","zhí","yǒu","yí","gè","xiǎng","fǎ",null,"zì","jǐ","kāi","shǐ","dé","tài","wǎn",null,"qián","yě","bù","duō",null,"rú","guǒ","bù","bǐ","bié","rén","gèng","kǔ",null,"gèng","jiǔ",null,"gèng","néng","rěn",null,"yǐ","hòu","yí","dìng","hái","shì","ruò","de","rén",null],"所以他不肯停。手痛了，他继续。肚子饿了，他继续。天黑了，他还是继续。":["suǒ","yǐ","tā","bù","kěn","tíng",null,"shǒu","tòng","le",null,"tā","jì","xù",null,"dù","zǐ","è","le",null,"tā","jì","xù",null,"tiān","hēi","le",null,"tā","hái","shì","jì","xù",null],"可是打得越久，他心里越乱。他开始想：":["kě","shì","dǎ","dé","yuè","jiǔ",null,"tā","xīn","lǐ","yuè","luàn",null,"tā","kāi","shǐ","xiǎng",null],"我是不是太慢了？":["wǒ","shì","bu","shì","tài","màn","le",null],"他又想：":["tā","yòu","xiǎng",null],"我是不是再练也没有用？":["wǒ","shì","bu","shì","zài","liàn","yě","méi","yǒu","yòng",null],"教官一直在旁边看。":["jiào","guān","yì","zhí","zài","páng","biān","kàn",null],"教官没有马上说话。只在杂草快没有力气的时候，教官问了一句：":["jiào","guān","méi","yǒu","mǎ","shàng","shuō","huà",null,"zhī","zài","zá","cǎo","kuài","méi","yǒu","lì","qi","de","shí","hòu",null,"jiào","guān","wèn","le","yí","jù",null],"你是在练，还是只是在生气？":["nǐ","shì","zài","liàn",null,"hái","shì","zhǐ","shì","zài","shēng","qì",null],"教官的话是什么意思？":["jiào","guān","de","huà","shì","shén","me","yì","sī",null],"我需要先想清楚再打，而不是乱打。":["wǒ","xū","yào","xiān","xiǎng","qīng","chǔ","zài","dǎ",null,"ér","bú","shì","luàn","dǎ",null],"我需要打更用力！":["wǒ","xū","yào","dǎ","gēng","yòng","lì",null],"我需要先睡一觉。":["wǒ","xū","yào","xiān","shuì","yí","jiào",null],"杂草第一次停下来，看着手里的木剑，又看着前面的稻草人。他突然明白，一直乱打，不等于真正变强。":["zá","cǎo","dì","yī","cì","tíng","xià","lái",null,"kàn","zhuó","shǒu","lǐ","de","mù","jiàn",null,"yòu","kàn","zhe","qián","miàn","de","dào","cǎo","rén",null,"tā","tū","rán","míng","bái",null,"yì","zhí","luàn","dǎ",null,"bù","děng","yú","zhēn","zhèng","biàn","qiáng",null],"不完全是。杂草停下来，看着手里的木剑，突然明白，他不是在跟稻草人练，而是在跟自己心里的怕打。":["bù","wán","quán","shì",null,"zá","cǎo","tíng","xià","lái",null,"kàn","zhuó","shǒu","lǐ","de","mù","jiàn",null,"tū","rán","míng","bái",null,"tā","bú","shì","zài","gēn","dào","cǎo","rén","liàn",null,"ér","shì","zài","gēn","zì","jǐ","xīn","lǐ","de","pà","dǎ",null],"从那以后，杂草还是继续练，可是方法变了。他先看，再想，然后再打。每一下都更稳，也更安静。":["cóng","nà","yǐ","hòu",null,"zá","cǎo","hái","shì","jì","xù","liàn",null,"kě","shì","fāng","fǎ","biàn","le",null,"tā","xiān","kàn",null,"zài","xiǎng",null,"rán","hòu","zài","dǎ",null,"měi","yí","xià","dōu","gèng","wěn",null,"yě","gèng","ān","jìng",null],"没过多久，教官走过来，把一个特别任务交给了他。":["méi","guò","duō","jiǔ",null,"jiào","guān","zǒu","guò","lái",null,"bǎ","yí","gè","tè","bié","rèn","wu","jiāo","gěi","le","tā",null],"那一刻，杂草才知道，真正让人变强的，不只是吃苦，也是愿意改自己。":["nà","yí","kè",null,"zá","cǎo","cái","zhī","dào",null,"zhēn","zhèng","ràng","rén","biàn","qiáng","de",null,"bù","zhǐ","shì","chī","kǔ",null,"yě","shì","yuàn","yì","gǎi","zì","jǐ",null],"杂草在训练场打了很久的稻草人，直到教官问他：你是在练，还是只是在生气？他学会了先看、先想、再动手。":["zá","cǎo","zài","xùn","liàn","chǎng","dǎ","le","hěn","jiǔ","de","dào","cǎo","rén",null,"zhí","dào","jiào","guān","wèn","tā",null,"nǐ","shì","zài","liàn",null,"hái","shì","zhǐ","shì","zài","shēng","qì",null,"tā","xué","huì","le","xiān","kàn",null,"xiān","xiǎng",null,"zài","dòng","shǒu",null],"那一天，训练场里的人一个一个走了。有人去吃饭，有人去接任务。最后只剩下杂草。":["nà","yì","tiān",null,"xùn","liàn","chǎng","lǐ","de","rén","yí","gè","yi","gè","zǒu","le",null,"yǒu","rén","qù","chī","fàn",null,"yǒu","rén","qù","jiē","rèn","wu",null,"zuì","hòu","zhī","shèng","xià","zá","cǎo",null],"他站在木头人前面，反复练同一个动作。可是练了很久，还是不对。木剑总是偏一点。脚也总是慢半步。":["tā","zhàn","zài","mù","tou","rén","qián","miàn",null,"fǎn","fù","liàn","tóng","yí","gè","dòng","zuò",null,"kě","shì","liàn","le","hěn","jiǔ",null,"hái","shì","bú","duì",null,"mù","jiàn","zǒng","shì","piān","yì","diǎn",null,"jiǎo","yě","zǒng","shì","màn","bàn","bù",null],"教官在远处看着，没有马上过来。杂草心里很急。他知道自己做得不对。可是他不想问。":["jiào","guān","zài","yuǎn","chù","kàn","zhe",null,"méi","yǒu","mǎ","shàng","guò","lái",null,"zá","cǎo","xīn","lǐ","hěn","jí",null,"tā","zhī","dào","zì","jǐ","zuò","dé","bú","duì",null,"kě","shì","tā","bù","xiǎng","wèn",null],"杂草应该问教官吗？":["zá","cǎo","yīng","gāi","wèn","jiào","guān","ma",null],"是的，问别人不丢人。":["shì","de",null,"wèn","bié","rén","bù","diū","rén",null],"不，我自己能搞定。":["bù",null,"wǒ","zì","jǐ","néng","gǎo","dìng",null],"我看看有没有攻略视频。":["wǒ","kàn","kàn","yǒu","méi","yǒu","gōng","lüè","shì","pín",null],"杂草只是一直重复。一次不行，就再来一次。十次不行，就再来十次。可是越这样，他的身体越硬。心里也越烦。":["zá","cǎo","zhǐ","shì","yì","zhí","chóng","fù",null,"yí","cì","bù","xíng",null,"jiù","zài","lái","yí","cì",null,"shí","cì","bù","xíng",null,"jiù","zài","lái","shí","cì",null,"kě","shì","yuè","zhè","yàng",null,"tā","de","shēn","tǐ","yuè","yìng",null,"xīn","lǐ","yě","yuè","fán",null],"杂草心里想：如果连这种事都要问，说明自己太弱。可是他又想：如果一直错下去，不是更弱吗？":["zá","cǎo","xīn","lǐ","xiǎng",null,"rú","guǒ","lián","zhè","zhǒng","shì","dōu","yào","wèn",null,"shuō","míng","zì","jǐ","tài","ruò",null,"kě","shì","tā","yòu","xiǎng",null,"rú","guǒ","yì","zhí","cuò","xià","qù",null,"bú","shì","gèng","ruò","ma",null],"后来，教官终于走过来。":["hòu","lái",null,"jiào","guān","zhōng","yú","zǒu","guò","lái",null],"教官没有笑他。教官只是说：":["jiào","guān","méi","yǒu","xiào","tā",null,"jiào","guān","zhǐ","shì","shuō",null],"你的手太紧了。":["nǐ","de","shǒu","tài","jǐn","le",null],"杂草听见以后，脸一下子热了。因为这句话很简单。简单得像他早一点开口就能得到。":["zá","cǎo","tīng","jiàn","yǐ","hòu",null,"liǎn","yí","xià","zǐ","rè","le",null,"yīn","wèi","zhè","jù","huà","hěn","jiǎn","dān",null,"jiǎn","dān","dé","xiàng","tā","zǎo","yì","diǎn","kāi","kǒu","jiù","néng","dé","dào",null],"教官又提醒他说：":["jiào","guān","yòu","tí","xǐng","tā","shuō",null],"不是一直用力，就会更强。合适的时候放松，动作才会对。":["bú","shì","yì","zhí","yòng","lì",null,"jiù","huì","gèng","qiáng",null,"hé","shì","de","shí","hòu","fàng","sōng",null,"dòng","zuò","cái","huì","duì",null],"杂草这一次没有装作没听见。他低声问：":["zá","cǎo","zhè","yí","cì","méi","yǒu","zhuāng","zuò","méi","tīng","jiàn",null,"tā","dī","shēng","wèn",null],"那我应该先看哪里？":["nà","wǒ","yīng","gāi","xiān","kàn","nǎ","lǐ",null],"教官指了指他的手，又指了指他的脚。杂草再练一次的时候，真的比刚才顺了很多。":["jiào","guān","zhǐ","le","zhǐ","tā","de","shǒu",null,"yòu","zhǐ","le","zhǐ","tā","de","jiǎo",null,"zá","cǎo","zài","liàn","yí","cì","de","shí","hòu",null,"zhēn","de","bǐ","gāng","cái","shùn","le","hěn","duō",null],"那一刻他才明白，自己刚才不是在坚持。自己刚才只是不肯承认，别人也能帮他变强。":["nà","yí","kè","tā","cái","míng","bái",null,"zì","jǐ","gāng","cái","bú","shì","zài","jiān","chí",null,"zì","jǐ","gāng","cái","zhǐ","shì","bù","kěn","chéng","rèn",null,"bié","rén","yě","néng","bāng","tā","biàn","qiáng",null],"训练场里还是只有他一个人。可是这一次，他不再觉得一个人就一定要什么都自己扛。":["xùn","liàn","chǎng","lǐ","hái","shì","zhǐ","yǒu","tā","yí","gè","rén",null,"kě","shì","zhè","yí","cì",null,"tā","bú","zài","jué","de","yí","gè","rén","jiù","yí","dìng","yào","shén","me","dōu","zì","jǐ","káng",null],"杂草在训练场里一个人练到很晚，直到他终于开口问教官。他学会了：一个人不一定要什么都自己扛。":["zá","cǎo","zài","xùn","liàn","chǎng","lǐ","yí","gè","rén","liàn","dào","hěn","wǎn",null,"zhí","dào","tā","zhōng","yú","kāi","kǒu","wèn","jiào","guān",null,"tā","xué","huì","le",null,"yí","gè","rén","bù","yí","dìng","yào","shén","me","dōu","zì","jǐ","káng",null],"杂草为了一个关于月光的任务，先去找雕刻店的店主，又去酒馆找吟游诗人，后来还去找旧女仆。":["zá","cǎo","wèi","le","yí","gè","guān","yú","yuè","guāng","de","rèn","wu",null,"xiān","qù","zhǎo","diāo","kè","diàn","de","diàn","zhǔ",null,"yòu","qù","jiǔ","guǎn","zhǎo","yín","yóu","shī","rén",null,"hòu","lái","hái","qù","zhǎo","jiù","nǚ","pú",null],"每个人都只说一点点，没有一个人把话一次说完。杂草本来就不是喜欢听故事的人。":["měi","gè","rén","dōu","zhī","shuō","yì","diǎn","diǎn",null,"méi","yǒu","yí","gè","rén","bǎ","huà","yí","cì","shuō","wán",null,"zá","cǎo","běn","lái","jiù","bú","shì","xǐ","huan","tīng","gù","shì","de","rén",null],"他觉得故事太慢，也太远。故事不能马上变成钱，也不能马上让人变强。":["tā","jué","de","gù","shì","tài","màn",null,"yě","tài","yuǎn",null,"gù","shì","bù","néng","mǎ","shàng","biàn","chéng","qián",null,"yě","bù","néng","mǎ","shàng","ràng","rén","biàn","qiáng",null],"杂草应该继续听这些慢吞吞的故事吗？":["zá","cǎo","yīng","gāi","jì","xù","tīng","zhè","xiē","màn","tūn","tūn","de","gù","shì","ma",null],"是的，耐心也是一种技能。":["shì","de",null,"nài","xīn","yě","shì","yì","zhǒng","jì","néng",null],"不，这是浪费时间。":["bù",null,"zhè","shì","làng","fèi","shí","jiān",null],"假装在听，其实在想午饭吃什么。":["jiǎ","zhuāng","zài","tīng",null,"qí","shí","zài","xiǎng","wǔ","fàn","chī","shén","me",null],"杂草站起来准备离开。可是他忽然想到自己在训练场的日子。那时候，别人也觉得打稻草人没有用。可是正是那些看起来没用的时间，让他后来拿到了任务。":["zá","cǎo","zhàn","qǐ","lái","zhǔn","bèi","lí","kāi",null,"kě","shì","tā","hū","rán","xiǎng","dào","zì","jǐ","zài","xùn","liàn","chǎng","de","rì","zi",null,"nà","shí","hòu",null,"bié","rén","yě","jué","de","dǎ","dào","cǎo","rén","méi","yǒu","yòng",null,"kě","shì","zhèng","shì","nà","xiē","kàn","qǐ","lái","méi","yòng","de","shí","jiān",null,"ràng","tā","hòu","lái","ná","dào","le","rèn","wu",null],"想到这里，他又坐下来了。这一次，他不再只想":["xiǎng","dào","zhè","lǐ",null,"tā","yòu","zuò","xià","lái","le",null,"zhè","yí","cì",null,"tā","bú","zài","zhī","xiǎng"],"快点结束":["kuài","diǎn","jié","shù"],"，而是开始认真听，认真问，也认真把每个人的话放在一起想。":[null,"ér","shì","kāi","shǐ","rèn","zhēn","tīng",null,"rèn","zhēn","wèn",null,"yě","rèn","zhēn","bǎ","měi","gè","rén","de","huà","fàng","zài","yì","qǐ","xiǎng",null],"慢慢地，一条线在他眼前清楚起来。月光不是普通的名字，扎哈布也不是普通的雕刻家。那份约定、那个夜晚、那把像剑一样的雕刻刀，原来都连在一起。":["màn","màn","dì",null,"yì","tiáo","xiàn","zài","tā","yǎn","qián","qīng","chǔ","qǐ","lái",null,"yuè","guāng","bú","shì","pǔ","tōng","de","míng","zì",null,"zhā","hā","bù","yě","bú","shì","pǔ","tōng","de","diāo","kè","jiā",null,"nà","fèn","yuē","dìng",null,"nà","ge","yè","wǎn",null,"nà","bǎ","xiàng","jiàn","yí","yàng","de","diāo","kè","dāo",null,"yuán","lái","dōu","lián","zài","yì","qǐ",null],"以前的他也许会因为怕麻烦而转身就走，这一次他却没有。他终于明白，有些最好的东西，不会大声叫你过去。你要先安静下来，才会真的听见。":["yǐ","qián","de","tā","yě","xǔ","huì","yīn","wèi","pà","má","fán","ér","zhuǎn","shēn","jiù","zǒu",null,"zhè","yí","cì","tā","què","méi","yǒu",null,"tā","zhōng","yú","míng","bái",null,"yǒu","xiē","zuì","hǎo","de","dōng","xī",null,"bú","huì","dà","shēng","jiào","nǐ","guò","qù",null,"nǐ","yào","xiān","ān","jìng","xià","lái",null,"cái","huì","zhēn","de","tīng","jiàn",null],"杂草终于走到了可以换职业的时候。很多人都很兴奋。有人想做骑士。有人想做魔法师。":["zá","cǎo","zhōng","yú","zǒu","dào","le","kě","yǐ","huàn","zhí","yè","de","shí","hòu",null,"hěn","duō","rén","dōu","hěn","xīng","fèn",null,"yǒu","rén","xiǎng","zuò","qí","shì",null,"yǒu","rén","xiǎng","zuò","mó","fǎ","shī",null],"后来，他听见有人提到雕刻师。那个人一说完，旁边的人都笑了。有人说：":["hòu","lái",null,"tā","tīng","jiàn","yǒu","rén","tí","dào","diāo","kè","shī",null,"nà","ge","rén","yì","shuō","wán",null,"páng","biān","de","rén","dōu","xiào","le",null,"yǒu","rén","shuō",null],"那种职业能做什么？":["nà","zhǒng","zhí","yè","néng","zuò","shén","me",null],"还有人说：":["hái","yǒu","rén","shuō",null],"选那个，不如什么都不选。":["xuǎn","nà","ge",null,"bù","rú","shén","me","dōu","bù","xuǎn",null],"杂草应该选什么职业？":["zá","cǎo","yīng","gāi","xuǎn","shén","me","zhí","yè",null],"雕刻师。真正有用的东西，不一定写在表面上。":["diāo","kè","shī",null,"zhēn","zhèng","yǒu","yòng","de","dōng","xī",null,"bù","yí","dìng","xiě","zài","biǎo","miàn","shàng",null],"骑士！看起来比较帅。":["qí","shì",null,"kàn","qǐ","lái","bǐ","jiào","shuài",null],"魔法师！会放火比较厉害。":["mó","fǎ","shī",null,"huì","fàng","huǒ","bǐ","jiào","lì","hài",null],"杂草差点选了更安全的路。可是他又想到一件事：真正有用的东西，不一定会在表面上写出来。如果每个人都觉得一个职业没用，也许只是因为他们只看今天。":["zá","cǎo","chà","diǎn","xuǎn","le","gèng","ān","quán","de","lù",null,"kě","shì","tā","yòu","xiǎng","dào","yí","jiàn","shì",null,"zhēn","zhèng","yǒu","yòng","de","dōng","xī",null,"bù","yí","dìng","huì","zài","biǎo","miàn","shàng","xiě","chū","lái",null,"rú","guǒ","měi","gè","rén","dōu","jué","de","yí","gè","zhí","yè","méi","yòng",null,"yě","xǔ","zhǐ","shì","yīn","wèi","tā","men","zhī","kàn","jīn","tiān",null],"杂草慢慢走过去。周围的人还在把雕刻师当笑话。杂草听见了，可是没有回头。":["zá","cǎo","màn","màn","zǒu","guò","qù",null,"zhōu","wéi","de","rén","hái","zài","bǎ","diāo","kè","shī","dāng","xiào","huà",null,"zá","cǎo","tīng","jiàn","le",null,"kě","shì","méi","yǒu","huí","tóu",null],"他做出了自己的选择。那一刻，没有掌声。也没有人觉得他很聪明。可是杂草心里反而安静。":["tā","zuò","chū","le","zì","jǐ","de","xuǎn","zé",null,"nà","yí","kè",null,"méi","yǒu","zhǎng","shēng",null,"yě","méi","yǒu","rén","jué","de","tā","hěn","cōng","ming",null,"kě","shì","zá","cǎo","xīn","lǐ","fǎn","ér","ān","jìng",null],"因为他终于不是照着别人的眼睛选路。他是在照着自己最清楚的地方走。":["yīn","wèi","tā","zhōng","yú","bú","shì","zhào","zhe","bié","rén","de","yǎn","jīng","xuǎn","lù",null,"tā","shì","zài","zhào","zhe","zì","jǐ","zuì","qīng","chǔ","de","dì","fāng","zǒu",null],"换了职业以后，杂草拿到了一把小小的雕刻刀。那把刀不像剑。也不像别人的高级武器。它很短，也很安静。":["huàn","le","zhí","yè","yǐ","hòu",null,"zá","cǎo","ná","dào","le","yì","bǎ","xiǎo","xiǎo","de","diāo","kè","dāo",null,"nà","bǎ","dāo","bú","xiàng","jiàn",null,"yě","bú","xiàng","bié","rén","de","gāo","jí","wǔ","qì",null,"tā","hěn","duǎn",null,"yě","hěn","ān","jìng",null],"这把小刀教会了杂草什么？":["zhè","bǎ","xiǎo","dāo","jiào","huì","le","zá","cǎo","shén","me",null],"快没有用，乱也没有用。要先安静下来。":["kuài","méi","yǒu","yòng",null,"luàn","yě","méi","yǒu","yòng",null,"yào","xiān","ān","jìng","xià","lái",null],"动作要快要狠！":["dòng","zuò","yào","kuài","yào","hěn",null],"这刀太小了，能退货吗？":["zhè","dāo","tài","xiǎo","le",null,"néng","tuì","huò","ma",null],"不完全是。这把刀不是用来乱挥的。这种东西要小心。要轻轻地用。也要认真地看。":["bù","wán","quán","shì",null,"zhè","bǎ","dāo","bú","shì","yòng","lái","luàn","huī","de",null,"zhè","zhǒng","dōng","xī","yào","xiǎo","xīn",null,"yào","qīng","qīng","dì","yòng",null,"yě","yào","rèn","zhēn","dì","kàn",null],"杂草第一次正式练雕刻的时候，面前只放着一块普通木头。第一刀下去的时候，他太快了。木头马上歪了一边。":["zá","cǎo","dì","yī","cì","zhèng","shì","liàn","diāo","kè","de","shí","hòu",null,"miàn","qián","zhī","fàng","zhe","yí","kuài","pǔ","tōng","mù","tou",null,"dì","yī","dāo","xià","qù","de","shí","hòu",null,"tā","tài","kuài","le",null,"mù","tou","mǎ","shàng","wāi","le","yì","biān",null],"他本来以为，有决心就够了。现在他才发现，手也要跟上。眼睛也要跟上。心也要跟上。":["tā","běn","lái","yǐ","wéi",null,"yǒu","jué","xīn","jiù","gòu","le",null,"xiàn","zài","tā","cái","fā","xiàn",null,"shǒu","yě","yào","gēn","shàng",null,"yǎn","jīng","yě","yào","gēn","shàng",null,"xīn","yě","yào","gēn","shàng",null],"杂草坐了一会儿，没有马上再下刀。他先看着那块木头。后来又看着自己手里的刀。最后，他轻轻地呼了一口气。这一次，他决定重新来。":["zá","cǎo","zuò","le","yí","huì","er",null,"méi","yǒu","mǎ","shàng","zài","xià","dāo",null,"tā","xiān","kàn","zhe","nà","kuài","mù","tou",null,"hòu","lái","yòu","kàn","zhe","zì","jǐ","shǒu","lǐ","de","dāo",null,"zuì","hòu",null,"tā","qīng","qīng","dì","hū","le","yì","kǒu","qì",null,"zhè","yí","cì",null,"tā","jué","dìng","chóng","xīn","lái",null],"不是为了快。也不是为了马上做出很大的东西。他只想先把一个小小的表情做对。一点一点地，木头终于没有再乱掉。":["bú","shì","wèi","le","kuài",null,"yě","bú","shì","wèi","le","mǎ","shàng","zuò","chū","hěn","dà","de","dōng","xī",null,"tā","zhī","xiǎng","xiān","bǎ","yí","gè","xiǎo","xiǎo","de","biǎo","qíng","zuò","duì",null,"yì","diǎn","yi","diǎn","dì",null,"mù","tou","zhōng","yú","méi","yǒu","zài","luàn","diào",null],"做完以后，那东西还是很简单。也说不上多好看。可是杂草看了很久。这一次，他没有笑自己。":["zuò","wán","yǐ","hòu",null,"nà","dōng","xī","hái","shì","hěn","jiǎn","dān",null,"yě","shuō","bú","shàng","duō","hǎo","kàn",null,"kě","shì","zá","cǎo","kàn","le","hěn","jiǔ",null,"zhè","yí","cì",null,"tā","méi","yǒu","xiào","zì","jǐ",null],"因为他第一次明白，不满意的时候，不一定要生气。有时候，你只要安静地再做一次。":["yīn","wèi","tā","dì","yī","cì","míng","bái",null,"bù","mǎn","yì","de","shí","hòu",null,"bù","yí","dìng","yào","shēng","qì",null,"yǒu","shí","hòu",null,"nǐ","zhǐ","yào","ān","jìng","dì","zài","zuò","yí","cì",null],"杂草做出第一件还算像样的东西以后，把它带到了市场。市场里有很多摊位。也有很多人在大声说话。":["zá","cǎo","zuò","chū","dì","yī","jiàn","hái","suàn","xiàng","yàng","de","dōng","xī","yǐ","hòu",null,"bǎ","tā","dài","dào","le","shì","chǎng",null,"shì","chǎng","lǐ","yǒu","hěn","duō","tān","wèi",null,"yě","yǒu","hěn","duō","rén","zài","dà","shēng","shuō","huà",null],"他一开始站得很直。好像只要自己站得稳一点，别人就会觉得那东西也不错。可是第一个看见的人笑了。第二个人也笑了。":["tā","yì","kāi","shǐ","zhàn","dé","hěn","zhí",null,"hǎo","xiàng","zhǐ","yào","zì","jǐ","zhàn","dé","wěn","yì","diǎn",null,"bié","rén","jiù","huì","jué","de","nà","dōng","xī","yě","bú","cuò",null,"kě","shì","dì","yī","gè","kàn","jiàn","de","rén","xiào","le",null,"dì","èr","gè","rén","yě","xiào","le",null],"后来还有人直接取笑他。那个人说：":["hòu","lái","hái","yǒu","rén","zhí","jiē","qǔ","xiào","tā",null,"nà","ge","rén","shuō",null],"这个也有人要吗？":["zhè","ge","yě","yǒu","rén","yào","ma",null],"杂草听见以后，手一下子冷了。他差一点就想把东西收起来。":["zá","cǎo","tīng","jiàn","yǐ","hòu",null,"shǒu","yí","xià","zǐ","lěng","le",null,"tā","chà","yì","diǎn","jiù","xiǎng","bǎ","dōng","xī","shōu","qǐ","lái",null],"在他心里，一个老想法又出来了。如果大部分人都笑，说明这东西一定没有用。":["zài","tā","xīn","lǐ",null,"yí","gè","lǎo","xiǎng","fǎ","yòu","chū","lái","le",null,"rú","guǒ","dà","bù","fen","rén","dōu","xiào",null,"shuō","míng","zhè","dōng","xī","yí","dìng","méi","yǒu","yòng",null],"可是就在这时候，一个老人走到了他面前。老人没有笑。老人只是低头看了很久。":["kě","shì","jiù","zài","zhè","shí","hòu",null,"yí","gè","lǎo","rén","zǒu","dào","le","tā","miàn","qián",null,"lǎo","rén","méi","yǒu","xiào",null,"lǎo","rén","zhǐ","shì","dī","tóu","kàn","le","hěn","jiǔ",null],"后来，老人轻轻点头。老人说：":["hòu","lái",null,"lǎo","rén","qīng","qīng","diǎn","tóu",null,"lǎo","rén","shuō",null],"这东西还不成熟。可是做它的人很认真。":["zhè","dōng","xī","hái","bù","chéng","shú",null,"kě","shì","zuò","tā","de","rén","hěn","rèn","zhēn",null],"杂草听见这句话，心里忽然一静。因为老人看到的，不只是东西本身。老人也看见了他花在上面的时间。看见了他没有放弃的样子。":["zá","cǎo","tīng","jiàn","zhè","jù","huà",null,"xīn","lǐ","hū","rán","yí","jìng",null,"yīn","wèi","lǎo","rén","kàn","dào","de",null,"bù","zhǐ","shì","dōng","xī","běn","shēn",null,"lǎo","rén","yě","kàn","jiàn","le","tā","huā","zài","shàng","miàn","de","shí","jiān",null,"kàn","jiàn","le","tā","méi","yǒu","fàng","qì","de","yàng","zi",null],"杂草最后没有把那件东西丢掉。他反而把它收得更好。他终于明白，不是每个人的笑声都一样重要。只要有一个人真的看见了，你做的事就值得继续。":["zá","cǎo","zuì","hòu","méi","yǒu","bǎ","nà","jiàn","dōng","xī","diū","diào",null,"tā","fǎn","ér","bǎ","tā","shōu","dé","gèng","hǎo",null,"tā","zhōng","yú","míng","bái",null,"bú","shì","měi","gè","rén","de","xiào","shēng","dōu","yí","yàng","zhòng","yào",null,"zhǐ","yào","yǒu","yí","gè","rén","zhēn","de","kàn","jiàn","le",null,"nǐ","zuò","de","shì","jiù","zhí","dé","jì","xù",null],"杂草选择了雕刻师的路，拿到了第一把雕刻刀，做出了第一件作品。市场里有人笑，但也有一个老人看见了他的认真。":["zá","cǎo","xuǎn","zé","le","diāo","kè","shī","de","lù",null,"ná","dào","le","dì","yī","bǎ","diāo","kè","dāo",null,"zuò","chū","le","dì","yī","jiàn","zuò","pǐn",null,"shì","chǎng","lǐ","yǒu","rén","xiào",null,"dàn","yě","yǒu","yí","gè","lǎo","rén","kàn","jiàn","le","tā","de","rèn","zhēn",null],"新人，先别问怎么变强。先问自己能不能听完一句话。":["xīn","rén",null,"xiān","bié","wèn","zěn","me","biàn","qiáng",null,"xiān","wèn","zì","jǐ","néng","bu","néng","tīng","wán","yí","jù","huà",null],"师傅让你选第一项训练。":["shī","fu","ràng","nǐ","xuǎn","dì","yī","xiàng","xùn","liàn",null],"先练听命令。":["xiān","liàn","tīng","mìng","lìng",null],"先挥剑，看起来比较帅。":["xiān","huī","jiàn",null,"kàn","qǐ","lái","bǐ","jiào","shuài",null],"很好。活得久的人，通常不是最帅的人。":["hěn","hǎo",null,"huó","dé","jiǔ","de","rén",null,"tōng","cháng","bú","shì","zuì","shuài","de","rén",null],"剑挥得不错。差点打到自己，也算认识了敌人。":["jiàn","huī","dé","bú","cuò",null,"chà","diǎn","dǎ","dào","zì","jǐ",null,"yě","suàn","rèn","shi","le","dí","rén",null],"看，墙角的灰尘史莱姆被你吵醒了。正好，用它试试手。":["kàn",null,"qiáng","jiǎo","de","huī","chén","shǐ","lái","mǔ","bèi","nǐ","chǎo","xǐng","le",null,"zhèng","hǎo",null,"yòng","tā","shì","shì","shǒu",null],"陈佑学会了第一件事：系统不会替他理解别人的话。":["chén","yòu","xué","huì","le","dì","yī","jiàn","shì",null,"xì","tǒng","bú","huì","tì","tā","lǐ","jiě","bié","rén","de","huà",null],"白天，他在加油站工作。":["bái","tiān",null,"tā","zài","jiā","yóu","zhàn","gōng","zuò",null],"晚上，他回家以后，还要照顾奶奶和妹妹。":["wǎn","shàng",null,"tā","huí","jiā","yǐ","hòu",null,"hái","yào","zhào","gù","nǎi","nai","hé","mèi","mei",null],"李贤自己也很急，可是他不喜欢把“我很难”放在脸上。":["lǐ","xián","zì","jǐ","yě","hěn","jí",null,"kě","shì","tā","bù","xǐ","huan","bǎ",null,"wǒ","hěn","nán",null,"fàng","zài","liǎn","shàng",null],"他还有一个旧游戏账号。":["tā","hái","yǒu","yí","gè","jiù","yóu","xì","zhàng","hào",null],"他为什么要卖掉旧账号？":["tā","wèi","shén","me","yào","mài","diào","jiù","zhàng","hào",null],"为了家里的账单和生活费。":["wèi","le","jiā","lǐ","de","zhàng","dān","hé","shēng","huó","fèi",null],"因为他想证明自己很厉害。":["yīn","wèi","tā","xiǎng","zhèng","míng","zì","jǐ","hěn","lì","hài",null],"因为赚钱很容易。":["yīn","wèi","zhuàn","qián","hěn","róng","yì",null],"对。旧账号不是回忆，是奶奶的药费和妹妹的学费。":["duì",null,"jiù","zhàng","hào","bú","shì","huí","yì",null,"shì","nǎi","nai","de","yào","fèi","hé","mèi","mei","de","xué","fèi",null],"不完全对。李贤不卖骄傲，也不相信轻松的钱。他卖的是自己舍不得的时间。":["bù","wán","quán","duì",null,"lǐ","xián","bú","mài","jiāo","ào",null,"yě","bù","xiāng","xìn","qīng","sōng","de","qián",null,"tā","mài","de","shì","zì","jǐ","shè","bù","dé","de","shí","jiān",null],"李贤笑着说：“我回来了。”":["lǐ","xián","xiào","zhe","shuō",null,null,"huí","lái","le","。”",null,null],"他把声音放轻，只说：“今天有点累，但没事。”":["tā","bǎ","shēng","yīn","fàng","qīng",null,"zhī","shuō",null,null,"tiān","yǒu","diǎn","lèi","，",null,"méi","shì","。”",null,null],"她只问：“今天很累吗？”":["tā","zhī","wèn",null,null,"tiān","hěn","lèi","ma","？”",null,null],"李贤还是说：“没事。”":["lǐ","xián","hái","shì","shuō",null,null,"shì","。”",null,null],"旧头盔亮起来，皇家之路在黑暗里等他。":["jiù","tóu","kuī","liàng",