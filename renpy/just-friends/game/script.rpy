    def chunky_line(node_id, text):
        chunky_event("lineChanged", {"nodeId": node_id, "text": text})

    def chunky_choice(node_id, choice_id, text):
        chunky_event("choiceSelected", {"nodeId": node_id, "choiceId": choice_id, "text": text})

    def chunky_complete(node_id, quest_id, outcome_id):
        chunky_event("questComplete", {"nodeId": node_id, "questId": quest_id, "outcomeId": outcome_id})

