      "id": "real-world-apartment",
      "name": {
        "chinese": "狭小的出租屋",
        "english": "Cramped rented room"
      },
      "description": {
        "chinese": "墙很薄，账单却很厚。李贤坐在床边，听见冰箱低低地响，好像也在叹气。",
        "english": "The walls are thin, but the bills are thick. Lee Hyun sits on the bed and hears the refrigerator hum as if it is sighing too."
      },
      "backgroundId": "real-apartment-night",
      "availableActions": [
        {
          "id": "enter-virtual-world",
          "kind": "quest",
          "targetId": "opening-crossing",
          "label": {
            "chinese": "戴上旧头盔，进入罗德之路。",
            "english": "Put on the old headset and enter Royal Road."
          }
        }
      ],
      "travelTo": []
    },
    "town-square": {
      "id": "town-square",
      "name": {
        "chinese": "晨光广场",
        "english": "Morninglight Square"
      },
      "description": {
        "chinese": "阳光落在石路上，喷泉旁的人们吵得很有精神。这里没有人认识陈佑，也没有人知道他的债。",
        "english": "Sunlight falls across the stone road, and the people near the fountain argue with cheerful energy. No one here knows Chen You, and no one knows his debt."
      },
      "backgroundId": "town-square-day",
      "availableActions": [
        {
          "id": "ask-first-work",
          "kind": "quest",
          "targetId": "first-lesson",
          "label": {
            "chinese": "向训练馆师傅打听第一份工作。",
            "english": "Ask the training master about a first job."
          }
        }
      ],
      "travelTo": ["training-hall", "sculpture-workshop"]
    },
    "training-hall": {
      "id": "training-hall",
      "name": {
        "chinese": "训练馆",
        "english": "Training Hall"
      },
      "description": {
        "chinese": "木剑敲在一起，声音像雨点。师傅说，穷人练剑要先练耳朵，因为听错命令最贵。",
        "english": "Wooden swords knock together like rain. The master says poor students should train their ears first, because misheard orders are expensive."
      },
      "backgroundId": "training-hall",
      "availableActions": [
        {
          "id": "ask-first-work",
          "kind": "quest",
          "targetId": "first-lesson",
          "label": {
            "chinese": "接受一次不太体面的入门训练。",
            "english": "Accept a not-very-glorious first lesson."
          }
        }
      ],
      "travelTo": ["town-square", "sculpture-workshop"]
    },
    "sculpture-workshop": {
      "id": "sculpture-workshop",
      "name": {
        "chinese": "石屑工坊",
        "english": "Stonechip Workshop"
      },
      "description": {
        "chinese": "工坊里到处是灰，坏掉的雕像排成一排，像在等一个更倒霉的人来拯救它们。",
        "english": "Dust covers the workshop. Broken statues stand in a row as if waiting for someone even less fortunate to rescue them."
      },
      "restoredDescription": {
        "chinese": "窗户擦亮后，石屑工坊看起来像真正的店。坏掉的雕像少了，奇怪的委托却更多了。",
        "english": "With the windows cleaned, Stonechip Workshop almost looks like a real shop. There are fewer broken statues and more strange commissions."
      },
      "backgroundId": "workshop-before",
      "restoredBackgroundId": "workshop-restored",
      "availableActions": [
        {
          "id": "repair-workshop",
          "kind": "quest",
          "targetId": "workshop-restoration",
          "label": {
            "chinese": "帮老板修复门口那座倒霉雕像。",
            "english": "Help the owner repair the unlucky statue by the door."
          },
          "conditions": [
            {
              "op": "worldQuestStatus",
              "questId": "workshop-restoration",
              "status": "available"
            }
          ]
        },
        {
          "id": "take-commission",
          "kind": "encounterPool",
          "targetId": "sculpture-commissions",
          "label": {
            "chinese": "接一个小雕刻委托。",
            "english": "Take a small sculpture commission."
          },
          "conditions": [
