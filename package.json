{
  "name": "chunkychinesevocab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-startup-budget.mjs",
    "check:bundle": "node scripts/check-startup-budget.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "generate:reader-pack": "node scripts/generate-lms-reader-pack.mjs",
