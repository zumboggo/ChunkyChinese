    def chunky_event(name, payload=None):
        if payload is None:
            payload = {}
        payload["type"] = name
        payload["storyId"] = "just-friends-story"
        if renpy.emscripten:
            renpy.emscripten.run_script(
                "window.parent && window.parent.postMessage(" + json.dumps({"source": "chunky-renpy", "payload": payload}) + ", '*')"
