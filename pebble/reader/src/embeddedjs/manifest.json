          "uint32_t",
          "uint32_t"
        ],
        "returns": "void"
      },
      "showScene": {
        "arguments": [
          "uint32_t"
        ],
        "returns": "void"
      },
      "sceneSelect": {
        "arguments": [],
        "returns": "uint32_t"
      },
      "setBackgroundMotion": {
        "arguments": [
          "uint32_t"
        ],
