{
  "name": "chunky-pebble-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "export": "node scripts/export.mjs",
    "test": "node --test tests/*.test.mjs",
    "art": "python3 pixel-reactions/build-native.py && node scripts/configure-reading.mjs",
    "scenes": "node scripts/generate-scenes.mjs",
    "check": "sh scripts/build.sh --check",
    "build": "sh scripts/build.sh --dev",
    "release": "sh scripts/build.sh --release",
    "test:browser": "node preview/train-scene.test.mjs",
    "test:emulator": "python3 scripts/test-emulator.py",
    "catalogue": "node scripts/episode-author.mjs catalogue",
    "preflight": "node scripts/episode-author.mjs preflight",
    "review": "node scripts/episode-author.mjs review",
    "content": "node scripts/episode-author.mjs content",
    "direct": "node scripts/episode-author.mjs direct",
    "runtime:record": "node scripts/runtime-profile.mjs",
    "test:review": "node authoring/review.test.mjs"
  },
  "devDependencies": {
    "sharp": "0.35.3",
    "rolldown": "1.0.3"
  }
}
