{"format":1,"id":"supportive-25","version":"eca03b1d94ee","title":"The Call","shortTitle":"The Call","number":25,"sources":[{"title":"Super Supportive — Sleyca, Chapter 8","url":"https://www.royalroad.com/fiction/63759/super-supportive","note":"Adapted from the user-provided EPUB: the call to Clytem Zhao through the invitation to Victor. No actual visit to Gorgon yet."}],"entry":0,"nodes":[{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"xiàn zài，","en":"Now,"},{"py":"wǒ kěn dìng shuì bù zháo。","en":"I definitely can't sleep."},{"py":"xīn lǐ yǒu tài duō shì，","en":"There's too much on my mind,"},{"py":"yì zhí xiǎng gè bù tíng。","en":"and I can't stop thinking."}]},{"type":"animation","id":"download-supportive-25-opening-1","recipe":"1,5,3,6,0,6,0,0,0,0,0,1000,-1,-14,-32,-70,1500,-2,-23,-42,-100,3200,-2,-23,-42,-100,3800,-1,-14,-32,-70,4800,0,0,0,0"},{"type":"reaction","actor":"Alden","emotion":"worried","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"jīn tiān wǎn shàng","en":"Tonight"},{"py":"yǐ jīng zhè me bù hǎo le。","en":"has already been this bad."},{"py":"zài zuò yí jiàn nán zuò de shì，","en":"Doing one more difficult thing"},{"py":"yě méi shén me ba。","en":"can't hurt, right?"}]},{"type":"animation","id":"download-supportive-25-opening-2","recipe":"1,5,3,6,0,5,0,0,0,0,0,1200,3,0,0,100,2400,4,0,0,100,3600,1,0,0,20,4800,1,0,0,20"},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"choice","id":"ready","options":[{"id":"now","phrases":[{"py":"jiù xiàn zài dǎ ba。","en":"Make the call now."}],"to":7},{"id":"breathe","phrases":[{"py":"xiān ràng zì jǐ màn yì diǎn。","en":"Slow down first."}],"to":10}]},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"yì zhí děng xià qù，","en":"If I keep waiting,"},{"py":"zhè ge diàn huà","en":"this call"},{"py":"yě bú huì biàn de róng yì。","en":"won't get any easier."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"goto","to":12},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"wǒ ná zhe shǒu jī，","en":"I hold my phone,"},{"py":"ràng zì jǐ xiān màn yì diǎn。","en":"letting myself slow down first."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"wǒ ná chū shǒu jī，","en":"I take out my phone,"},{"py":"yòng shǒu diǎn le yí xià","en":"and tap"},{"py":"shàng miàn de fú hào。","en":"the symbol on it."},{"py":"wǒ xiān ràng zì jǐ màn yì diǎn，","en":"I slow myself down first,"},{"py":"zài shuō huà。","en":"then speak."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"dǎ gěi","en":"Call"},{"py":"kè lái tè mǔ · zhào。","en":"Clytem Zhao."}]},{"type":"reaction","actor":"Alden","emotion":"talking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"xì tǒng méi yǒu ràng wǒ","en":"The System doesn't let me"},{"py":"zhí jiē hé tā shuō huà，","en":"speak to her directly,"},{"py":"ér shì ràng wǒ","en":"but instead lets me"},{"py":"gěi tā liú yán。","en":"leave her a message."}]},{"type":"reaction","actor":"Alden","emotion":"surprised","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"hái hǎo。","en":"That's a relief."},{"py":"wǒ xiàn zài zhēn de bù xiǎng","en":"I really don't want right now"},{"py":"hé bié rén shuō hěn jiǔ，","en":"to talk with someone for a long time,"},{"py":"shuō xīn lǐ nà xiē shì。","en":"about everything on my mind."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"choice","id":"approach","options":[{"id":"short","phrases":[{"py":"shuō jiǎn dān yì diǎn。","en":"Keep it simple."}],"to":21},{"id":"reason","phrases":[{"py":"zhǐ shuō","en":"Just say"},{"py":"wǒ wèi shén me dǎ lái。","en":"why I'm calling."}],"to":24}]},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"jiǎn dān yì diǎn，","en":"Keep it simple—"},{"py":"zuì ān quán。","en":"that's safest."},{"py":"bǎ yào shuō de huà","en":"What I need to say—"},{"py":"shuō wán jiù hǎo。","en":"just get it said."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"goto","to":26},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"wǒ bú shì dǎ lái","en":"I'm not calling"},{"py":"shuō xīn lǐ de měi jiàn shì de。","en":"to discuss every feeling I have."},{"py":"shuō chū wǒ de jué dìng jiù hǎo。","en":"Just state my decision."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"zhào nǚ shì， nín hǎo。","en":"Hello, Ms. Zhao."},{"py":"wǒ shì ào ěr dēng。","en":"This is Alden."}]},{"type":"reaction","actor":"Alden","emotion":"talking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"duì bu qǐ，","en":"I'm sorry"},{"py":"zhè me jiǔ","en":"it's taken so long"},{"py":"cái gěi nín huí diàn huà。","en":"to return your call."}]},{"type":"reaction","actor":"Alden","emotion":"worried","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"wǒ xiǎng qù zàng lǐ。","en":"I'd like to go to the funeral."}]},{"type":"reaction","actor":"Alden","emotion":"talking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"rú guǒ dài wǒ guò qù","en":"If getting me there"},{"py":"bú huì ràng nín tài má fan de huà。","en":"wouldn't be too much trouble for you."}]},{"type":"reaction","actor":"Alden","emotion":"worried","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"xiè xie nín","en":"Thank you"},{"py":"yuàn yì dài wǒ qù。","en":"for offering to take me."}]},{"type":"reaction","actor":"Alden","emotion":"talking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"diàn huà dǎ wán le。","en":"The call is over."}]},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"hǎo le。","en":"There."},{"py":"jué dìng zuò le。","en":"Decision made."}]},{"type":"animation","id":"download-supportive-25-after-2","recipe":"1,5,3,6,0,5,0,0,0,0,0,1200,3,0,0,100,2400,4,0,0,100,3600,1,0,0,20,4800,1,0,0,20"},{"type":"choice","id":"aftermath","options":[{"id":"hand","phrases":[{"py":"kàn kàn shǒu lǐ de shǒu jī。","en":"Look at the phone in my hand."}],"to":40},{"id":"quiet","phrases":[{"py":"xiān bù shuō huà。","en":"Say nothing for now."}],"to":43}]},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"huà yǐ jīng shuō chū qù le。","en":"The words are out now."},{"py":"wǒ bú yòng zài ná zhe shǒu jī","en":"I don't have to keep holding my phone"},{"py":"xiǎng yào bu yào dǎ le。","en":"wondering whether to call."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"goto","to":45},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"wǒ méi zài shuō shén me。","en":"I don't say anything else."},{"py":"zhè ge jué dìng，","en":"This decision"},{"py":"yǐ jīng bù zhǐ shì","en":"is no longer just"},{"py":"xīn lǐ de xiǎng fǎ le。","en":"a thought in my head."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"jiē xià lái，","en":"Next,"},{"py":"děi zhǎo diǎn qí tā shì zuò。","en":"I need to find something else to do."},{"py":"wǒ bù xiǎng yì zhí xiǎng zhè xiē shì。","en":"I don't want to keep thinking about all this."}]},{"type":"animation","id":"download-supportive-25-distract-1","recipe":"1,5,3,6,0,6,0,0,0,0,0,1000,-1,-14,-32,-70,1500,-2,-23,-42,-100,3200,-2,-23,-42,-100,3800,-1,-14,-32,-70,4800,0,0,0,0"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"wǒ chuān shàng yí jiàn yī fu，","en":"I put on a shirt,"},{"py":"yòu zài wài miàn","en":"then over it"},{"py":"chuān shàng lián mào shān。","en":"put on my hoodie."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"bed"},{"type":"line","speaker":"Alden","scene":"bed","phrases":[{"py":"rán hòu，","en":"Then"},{"py":"wǒ ná zhe chuáng shàng de zhěn tou，","en":"I take the pillow from my bed"},{"py":"zǒu dào wài miàn de fáng jiān。","en":"and walk out into the next room."}]},{"type":"line","speaker":"Alden","scene":"home","phrases":[{"py":"māo hái zài nà lǐ，","en":"The cat is still there,"},{"py":"zài wén nà tiáo","en":"sniffing those shorts"},{"py":"wǒ yì diǎn yě bù xiǎng kàn jiàn de duǎn kù。","en":"that I don't want to see at all."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"home"},{"type":"choice","id":"companion","options":[{"id":"cat","phrases":[{"py":"kàn kàn wéi kè duō。","en":"Look at Victor."}],"to":53},{"id":"shorts","phrases":[{"py":"kàn kàn nà tiáo duǎn kù。","en":"Look at those shorts."}],"to":56}]},{"type":"line","speaker":"Alden","scene":"home","phrases":[{"py":"zhì shǎo，","en":"At least"},{"py":"zhè lǐ hái yǒu tā，","en":"he's here,"},{"py":"kě yǐ tīng wǒ shuō huà。","en":"and can listen to me."},{"py":"suī rán tā shì yì zhī māo。","en":"Even if he's a cat."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"home"},{"type":"goto","to":58},{"type":"line","speaker":"Alden","scene":"home","phrases":[{"py":"tā hǎo xiàng hěn xiǎng zhī dào","en":"He seems very curious about"},{"py":"nà ge dōng xi shì shén me。","en":"what that thing is."},{"py":"wǒ kě bù xiǎng。","en":"I certainly am not."}]},{"type":"reaction","actor":"Alden","emotion":"thinking","scene":"home"},{"type":"line","speaker":"Alden","scene":"home","phrases":[{"py":"nǐ xiǎng bu xiǎng","en":"Do you want"},{"py":"yì qǐ qù mǎi diǎn jīn qiāng yú，","en":"to go get some tuna together,"},{"py":"zài qù jiàn gè rén？","en":"and meet someone?"}]},{"type":"reaction","actor":"Alden","emotion":"talking","scene":"home"},{"type":"line","speaker":"Alden","scene":"home","phrases":[{"py":"wéi kè duō jiào le yì shēng。","en":"Victor meows."}]},{"type":"animation","id":"download-supportive-25-invite-2","recipe":"1,5,3,6,0,5,0,0,0,0